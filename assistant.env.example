# Copy to assistant.env on the server. Do not commit assistant.env.
# Both switches default to false. Leave them false until a person has
# validated the guide and updated the privacy pages for the chosen provider.
# The example key is empty on purpose.

ASSISTANT_ENABLED=false
ASSISTANT_MODEL_ENABLED=false
ASSISTANT_PROVIDER=openai-compatible
ASSISTANT_API_BASE=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
ASSISTANT_MAX_OUTPUT_TOKENS=400
ASSISTANT_ORIGINS=https://coconsult.fr,https://www.coconsult.fr
