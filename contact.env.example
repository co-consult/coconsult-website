# Copy to contact.env on the server. Do not commit contact.env.
# Do not replace an existing production contact.env with this example:
# that would drop the API key and turn sending off.
#
# Docker Compose reads this file, then applies the `environment` block.
# That block overrides env_file. CONTACT_SEND_ENABLED is therefore absent
# from compose.contact.yaml, so this file is the only switch.
#
# Production, after the send has been accepted: CONTACT_SEND_ENABLED=true
# Rollback, CI, and any other copy: CONTACT_SEND_ENABLED=false
# Missing, empty, or any value other than the exact string true keeps sending off.
BREVO_API_KEY=
CONTACT_FROM=
CONTACT_TO=contact@coconsult.fr
CONTACT_SEND_ENABLED=false
