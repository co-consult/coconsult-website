---
import '@/styles/global.css';
import '@/styles/experience.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ui } from '@/content/ui';
import type { Locale, RouteKey } from '@/content/types';
import { company } from '@/data/company';
import { absoluteUrl, pathFor, routes } from '@/data/routes';
import { breadcrumbLd, crumbsFor, jsonScript, organizationLd, webPageLd } from '@/lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routeKey: RouteKey | 'notFound';
  noindex?: boolean;
}
const { locale, title, description, routeKey, noindex = false } = Astro.props;
const t = ui[locale];
const path = routeKey === 'notFound' ? (locale === 'fr' ? '/404.html' : '/en/404/') : pathFor(locale, routeKey);
const canonical = absoluteUrl(routeKey === 'notFound' ? pathFor(locale, 'home') : path);
const frHref = absoluteUrl(routeKey === 'notFound' ? '/' : routes[routeKey].fr);
const enHref = absoluteUrl(routeKey === 'notFound' ? '/en/' : routes[routeKey].en);
const crumbs = routeKey === 'home' || routeKey === 'notFound' ? [] : crumbsFor(locale, routeKey, t.home);
const ldCrumbs = crumbs.map((item) => ({
  label: item.label,
  href: item.href ?? (routeKey === 'notFound' ? '/' : pathFor(locale, routeKey)),
}));
const graph = routeKey === 'home'
  ? [organizationLd(), webPageLd(locale, 'home', title, description)]
  : routeKey === 'notFound'
    ? []
    : [webPageLd(locale, routeKey, title, description), breadcrumbLd(ldCrumbs)];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111c" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {routeKey !== 'notFound' && <link rel="alternate" hreflang="fr" href={frHref} />}
    {routeKey !== 'notFound' && <link rel="alternate" hreflang="en" href={enHref} />}
    {routeKey !== 'notFound' && <link rel="alternate" hreflang="x-default" href={frHref} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl('/assets/brand/og-coconsult.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={company.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl('/assets/brand/og-coconsult.png')} />
    <meta name="twitter:image:alt" content={company.name} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {graph.length > 0 && <script type="application/ld+json" set:html={jsonScript(graph.length === 1 ? graph[0] : graph)} />}
  </head>
  <body>
    <Header locale={locale} routeKey={routeKey} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline src="/assets/main.js" defer></script>
    <script is:inline src="/assets/home.js" defer></script>
  </body>
</html>
