---
import ContactWizard from '@/components/contact/ContactWizard.astro';
import HomeExperience from '@/components/home/HomeExperience.astro';
import SectorExperience from '@/components/sectors/SectorExperience.astro';
import Blocks from '@/components/Blocks.astro';
import Base from '@/layouts/Base.astro';
import { ui } from '@/content/ui';
import type { Locale, PageContent, RouteKey } from '@/content/types';
import { crumbsFor } from '@/lib/seo';
import { routes } from '@/data/routes';

interface Props { locale: Locale; page: PageContent; }
const { locale, page } = Astro.props;
const crumbs = crumbsFor(locale, page.key, ui[locale].home);
const blocks = page.key === 'contact' ? page.blocks.filter((block) => block.type !== 'inquiries' && block.type !== 'note') : page.blocks;
const customShell = page.key === 'home' || page.key === 'contact' || page.key === 'sectors';
const serviceKeys: RouteKey[] = ['services', 'dedicated', 'qa', 'payments', 'automation', 'ai', 'software', 'cloud', 'cyber', 'modes'];
const serviceName = serviceKeys.includes(page.key) ? routes[page.key].label[locale] : undefined;
const faqBlock = page.blocks.find((block) => block.type === 'faq');
const faqs = faqBlock?.type === 'faq' ? faqBlock.items : [];
---
<Base locale={locale} title={page.metaTitle} description={page.description} routeKey={page.key} serviceName={serviceName} faqs={faqs}>
  {page.key === 'home' ? (
    <HomeExperience locale={locale} />
  ) : page.key === 'contact' ? (
    <ContactWizard locale={locale} page={page} />
  ) : page.key === 'sectors' ? (
    <SectorExperience locale={locale} page={page} />
  ) : (
    <header class="page-hero" data-page-hero>
      <div class="container">
        {crumbs.length > 0 && (
          <nav aria-label={ui[locale].breadcrumb}>
            <ol class="crumbs">
              {crumbs.map((crumb) => (
                <li>
                  {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
        {page.key === 'about' ? (
          <div class="about-hero-grid">
            <div class="about-hero-copy">
              <p class="eyebrow">{page.eyebrow}</p>
              <h1>{page.h1}</h1>
              <p class="lede">{page.intro}</p>
            </div>
            <div class="about-hero-art" aria-hidden="true">
              <svg class="about-orbit-art" viewBox="0 0 420 280" role="img">
                <defs>
                  <radialGradient id="aboutGlow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#026d7b" stop-opacity="0.22" />
                    <stop offset="100%" stop-color="#026d7b" stop-opacity="0" />
                  </radialGradient>
                </defs>
                <circle cx="210" cy="140" r="110" fill="url(#aboutGlow)" />
                <circle class="about-ring" cx="210" cy="140" r="78" fill="none" stroke="#026d7b" stroke-opacity="0.3" stroke-width="1.4" stroke-dasharray="5 8" />
                <g class="about-cities">
                  <rect x="78" y="108" width="96" height="64" rx="16" fill="#fff" stroke="#026d7b" stroke-width="1.5" />
                  <text x="126" y="136" text-anchor="middle" fill="#026d7b" font-size="13" font-family="IBM Plex Mono, monospace">Paris</text>
                  <text x="126" y="154" text-anchor="middle" fill="#24384c" font-size="11">COCONSULT</text>
                  <rect x="246" y="108" width="96" height="64" rx="16" fill="#fff" stroke="#c45c26" stroke-width="1.5" />
                  <text x="294" y="136" text-anchor="middle" fill="#c45c26" font-size="13" font-family="IBM Plex Mono, monospace">Sfax</text>
                  <text x="294" y="154" text-anchor="middle" fill="#24384c" font-size="11">Nearshore</text>
                </g>
                <path class="about-link" d="M174 140 H246" stroke="#026d7b" stroke-width="1.6" stroke-dasharray="4 6" fill="none" />
                <circle cx="210" cy="140" r="5" fill="#026d7b">
                  <animate attributeName="r" values="4;7;4" dur="2.4s" repeatCount="indefinite" />
                </circle>
              </svg>
            </div>
          </div>
        ) : (
          <>
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.h1}</h1>
            <p class="lede">{page.intro}</p>
          </>
        )}
      </div>
    </header>
  )}
  {!customShell && <Blocks locale={locale} blocks={blocks} />}
</Base>
