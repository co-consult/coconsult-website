---
import ContactWizard from '@/components/contact/ContactWizard.astro';
import HomeExperience from '@/components/home/HomeExperience.astro';
import SectorExperience from '@/components/sectors/SectorExperience.astro';
import SolutionsExperience from '@/components/solutions/SolutionsExperience.astro';
import PartnershipsExperience from '@/components/partnerships/PartnershipsExperience.astro';
import InnovationExperience from '@/components/innovation/InnovationExperience.astro';
import Blocks from '@/components/Blocks.astro';
import Base from '@/layouts/Base.astro';
import { ui } from '@/content/ui';
import type { Locale, PageContent, RouteKey } from '@/content/types';
import { crumbsFor } from '@/lib/seo';
import { routes } from '@/data/routes';
import { pageVisuals } from '@/data/page-visuals';

interface Props { locale: Locale; page: PageContent; }
const { locale, page } = Astro.props;
const crumbs = crumbsFor(locale, page.key, ui[locale].home);
const blocks = page.key === 'contact' ? page.blocks.filter((block) => block.type !== 'inquiries' && block.type !== 'note') : page.blocks;
const customShell =
  page.key === 'home' ||
  page.key === 'contact' ||
  page.key === 'sectors' ||
  page.key === 'solutions' ||
  page.key === 'partnerships' ||
  page.key === 'innovation';
const serviceKeys: RouteKey[] = ['services', 'dedicated', 'qa', 'payments', 'automation', 'ai', 'software', 'cloud', 'cyber', 'modes'];
const serviceName = serviceKeys.includes(page.key) ? routes[page.key].label[locale] : undefined;
const faqBlock = page.blocks.find((block) => block.type === 'faq');
const faqs = faqBlock?.type === 'faq' ? faqBlock.items : [];
const visual = pageVisuals[page.key];
const editorialKeys: RouteKey[] = ['about', 'services', 'cases', 'modes', 'software', 'dedicated', 'qa', 'cloud', 'cyber', 'ai', 'automation', 'payments'];
const isEditorial = editorialKeys.includes(page.key);
---
<Base locale={locale} title={page.metaTitle} description={page.description} routeKey={page.key} serviceName={serviceName} faqs={faqs}>
  {page.key === 'home' ? (
    <HomeExperience locale={locale} />
  ) : page.key === 'contact' ? (
    <ContactWizard locale={locale} page={page} />
  ) : page.key === 'sectors' ? (
    <SectorExperience locale={locale} page={page} />
  ) : page.key === 'solutions' ? (
    <SolutionsExperience locale={locale} page={page} />
  ) : page.key === 'partnerships' ? (
    <PartnershipsExperience locale={locale} page={page} />
  ) : page.key === 'innovation' ? (
    <InnovationExperience locale={locale} page={page} />
  ) : (
    <header class:list={['page-hero', visual?.lane && `page-hero-lane-${visual.lane}`]} data-page-hero>
      <div class="container">
        {crumbs.length > 0 && (
          <nav aria-label={ui[locale].breadcrumb}>
            <ol class="crumbs">
              {crumbs.map((crumb) => (
                <li>
                  {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
        {isEditorial && visual ? (
          <div class="about-hero-grid editorial-hero">
            <div class="about-hero-copy">
              <p class="eyebrow">{page.eyebrow}</p>
              <h1>{page.h1}</h1>
              <p class="lede">{page.intro}</p>
            </div>
            <div class="about-hero-art">
              <img
                class="about-hero-photo"
                src={visual.image}
                alt=""
                width="1200"
                height="900"
                loading="eager"
                decoding="async"
              />
              <div class="about-hero-overlay" aria-hidden="true">
                {page.key === 'about' ? (
                  <>
                    <span>Paris</span>
                    <span class="about-hero-dot"></span>
                    <span>Sfax</span>
                  </>
                ) : (
                  <span>{visual.overlay[locale]}</span>
                )}
              </div>
            </div>
          </div>
        ) : (
          <>
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.h1}</h1>
            <p class="lede">{page.intro}</p>
          </>
        )}
      </div>
    </header>
  )}
  {!customShell && (
    <div
      class:list={[
        'page-surface',
        page.key === 'services' && 'page-surface-services',
        page.key === 'cases' && 'page-surface-cases',
        page.key === 'modes' && 'page-surface-modes',
        serviceKeys.includes(page.key) && 'page-surface-service',
        visual?.lane && `page-surface-lane-${visual.lane}`,
      ]}
      data-service-lane={visual?.lane}
    >
      <Blocks locale={locale} blocks={blocks} />
    </div>
  )}
</Base>
