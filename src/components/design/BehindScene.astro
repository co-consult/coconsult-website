---
import '@/styles/behind.css';
import { behindCopy, type BehindLang } from '@/components/design/behind-copy';

interface Props {
  instance: string;
  autoplay?: boolean;
  locale?: BehindLang;
}
const { instance, autoplay = false, locale = 'fr' } = Astro.props;
const t = behindCopy[locale];
const name = `behind-layer-${instance}`;
---
<div
  class="behind-scene"
  data-behind
  data-version="3"
  data-mode="explore"
  data-autoplay={autoplay ? 'true' : undefined}
  data-phase="settle"
  data-closed="true"
  data-instance={instance}
>
  <header class="scene-intro">
    <h2 class="scene-title" data-i18n="sceneTitle">{t.sceneTitle}</h2>
    <p class="scene-guide" data-i18n="sceneGuide">{t.sceneGuide}</p>
  </header>
  <div class="stack" aria-hidden="true">
    <span class="aura"></span>
    <svg class="frame" viewBox="0 0 640 560" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id={`rim-${instance}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#8ef3ff" stop-opacity="0.55"></stop>
          <stop offset="45%" stop-color="#8ef3ff" stop-opacity="0.08"></stop>
          <stop offset="100%" stop-color="#8ef3ff" stop-opacity="0.35"></stop>
        </linearGradient>
      </defs>
      <rect class="frame-rim" x="10" y="10" width="620" height="540" rx="28" ry="28" fill="none" stroke={`url(#rim-${instance})`} stroke-width="1.2"></rect>
      <path class="frame-sheen" d="M36 28 H420" stroke="#d8fbff" stroke-opacity="0.35" stroke-width="1.4" stroke-linecap="round"></path>
    </svg>
    <svg class="traces" viewBox="0 0 640 560" preserveAspectRatio="none" aria-hidden="true">
      <path
        class="trace"
        d="M468 390 C 390 360 320 300 288 250 C 260 206 248 160 248 118"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        pathLength="1"
      ></path>
    </svg>
    <article class="btd-plate btd-cloud">
      <header class="btd-top">
        <p class="idx">04</p>
        <h3 data-i18n="cloudTitle">{t.cloudTitle}</h3>
      </header>
      <p data-i18n="cloudBody">{t.cloudBody}</p>
      <ul class="orders beats">
        <li><span data-i18n="cloudRole1">{t.cloudRole1}</span><span data-i18n="cloudDo1">{t.cloudDo1}</span></li>
        <li><span data-i18n="cloudRole2">{t.cloudRole2}</span><span data-i18n="cloudDo2">{t.cloudDo2}</span></li>
        <li><span data-i18n="cloudRole3">{t.cloudRole3}</span><span data-i18n="cloudDo3">{t.cloudDo3}</span></li>
      </ul>
    </article>
    <article class="btd-plate btd-data">
      <header class="btd-top">
        <p class="idx">03</p>
        <h3 data-i18n="dataTitle">{t.dataTitle}</h3>
      </header>
      <p data-i18n="dataBody">{t.dataBody}</p>
      <ul class="orders beats">
        <li><span data-i18n="dataRole1">{t.dataRole1}</span><span data-i18n="dataDo1">{t.dataDo1}</span></li>
        <li><span data-i18n="dataRole2">{t.dataRole2}</span><span data-i18n="dataDo2">{t.dataDo2}</span></li>
        <li><span data-i18n="dataRole3">{t.dataRole3}</span><span data-i18n="dataDo3">{t.dataDo3}</span></li>
      </ul>
    </article>
    <article class="btd-plate btd-arch">
      <header class="btd-top">
        <p class="idx">02</p>
        <h3 data-i18n="archTitle">{t.archTitle}</h3>
      </header>
      <p data-i18n="archBody">{t.archBody}</p>
      <ul class="orders beats">
        <li><span data-i18n="archRole1">{t.archRole1}</span><span data-i18n="archDo1">{t.archDo1}</span></li>
        <li><span data-i18n="archRole2">{t.archRole2}</span><span data-i18n="archDo2">{t.archDo2}</span></li>
        <li><span data-i18n="archRole3">{t.archRole3}</span><span data-i18n="archDo3">{t.archDo3}</span></li>
      </ul>
    </article>
    <article class="btd-plate btd-app">
      <header class="btd-top">
        <p class="idx">INT-1842</p>
        <h3 data-i18n="appTitle">{t.appTitle}</h3>
      </header>
      <ul class="orders">
        <li class="is-focus">
          <span data-i18n="place1">{t.place1}</span>
          <span data-i18n="job1">{t.job1}</span>
          <span class="state">
            <span class="status-open" data-i18n="open">{t.open}</span>
            <span class="status-done" data-i18n="done">{t.done}</span>
          </span>
        </li>
        <li>
          <span data-i18n="place2">{t.place2}</span>
          <span data-i18n="job2">{t.job2}</span>
          <span class="state quiet" data-i18n="open">{t.open}</span>
        </li>
        <li>
          <span data-i18n="place3">{t.place3}</span>
          <span data-i18n="job3">{t.job3}</span>
          <span class="state quiet" data-i18n="planned">{t.planned}</span>
        </li>
      </ul>
      <p class="action" data-i18n="action">{t.action}</p>
      <span class="sheen" aria-hidden="true"></span>
    </article>
    <article class="btd-plate btd-app btd-open">
      <header class="btd-top">
        <p class="idx">INT-1842</p>
        <h3 data-i18n="appTitle">{t.appTitle}</h3>
      </header>
      <ul class="orders">
        <li class="is-focus">
          <span data-i18n="place1">{t.place1}</span>
          <span data-i18n="job1">{t.job1}</span>
          <span class="state">
            <span class="status-open" data-i18n="open">{t.open}</span>
            <span class="status-done" data-i18n="done">{t.done}</span>
          </span>
        </li>
        <li>
          <span data-i18n="place2">{t.place2}</span>
          <span data-i18n="job2">{t.job2}</span>
          <span class="state quiet" data-i18n="open">{t.open}</span>
        </li>
        <li>
          <span data-i18n="place3">{t.place3}</span>
          <span data-i18n="job3">{t.job3}</span>
          <span class="state quiet" data-i18n="planned">{t.planned}</span>
        </li>
      </ul>
      <p class="action" data-i18n="action">{t.action}</p>
    </article>
    <span class="bead" aria-hidden="true"></span>
    <span class="seam" aria-hidden="true"></span>
    <span class="ground" aria-hidden="true"></span>
  </div>
  <div class="explorer">
    <fieldset class="layers" aria-label={t.layersLegend}>
      <legend class="sr" data-i18n="layersLegend">{t.layersLegend}</legend>
      <label><input type="radio" name={name} value="app" checked /> <span data-i18n="layerApp">{t.layerApp}</span></label>
      <label><input type="radio" name={name} value="arch" /> <span data-i18n="layerArch">{t.layerArch}</span></label>
      <label><input type="radio" name={name} value="data" /> <span data-i18n="layerData">{t.layerData}</span></label>
      <label><input type="radio" name={name} value="cloud" /> <span data-i18n="layerCloud">{t.layerCloud}</span></label>
    </fieldset>
    <p class="explain" data-explain aria-live="polite">{t.explainApp}</p>
    <p class="phase-line" data-phase-line aria-live="polite" hidden></p>
  </div>
  <div class="scene-actions">
    <button class="btn secondary" type="button" data-replay data-i18n="replay">{t.replay}</button>
    <button class="btn ghost" type="button" data-skip data-i18n="skip">{t.skip}</button>
  </div>
  <p class="behind-note" data-i18n="note">{t.note}</p>
</div>
<script>
  import { behindCopy, type BehindLang } from '@/components/design/behind-copy';

  if (document.documentElement.dataset.behindBound === 'true') {
    // The scene is used twice. The module must bind the page only once.
  } else {
  document.documentElement.dataset.behindBound = 'true';

  const phases = ['visible', 'reveal', 'flow'] as const;
  const marks = [0, 2200, 5800];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let lang: BehindLang = document.documentElement.lang === 'en' ? 'en' : 'fr';

  const text = (key: string) => {
    const value = behindCopy[lang][key as keyof typeof behindCopy.fr];
    return typeof value === 'string' ? value : '';
  };

  const phaseKey = (phase: string) => {
    if (phase === 'reveal') return 'phaseReveal';
    if (phase === 'flow') return 'phaseFlow';
    if (phase === 'settle') return 'phaseSettle';
    return 'phaseVisible';
  };

  const explainKey = (layer: string) => {
    if (layer === 'arch') return 'explainArch';
    if (layer === 'data') return 'explainData';
    if (layer === 'cloud') return 'explainCloud';
    return 'explainApp';
  };

  const selected = (scene: HTMLElement) =>
    scene.querySelector<HTMLInputElement>('input:checked')?.value || 'app';

  const renderCopy = (scene: HTMLElement) => {
    const explain = scene.querySelector<HTMLElement>('[data-explain]');
    const phaseLine = scene.querySelector<HTMLElement>('[data-phase-line]');
    const playing = scene.dataset.playing === 'true';
    scene.dataset.mode = playing ? 'intro' : 'explore';
    if (explain) {
      explain.hidden = playing;
      if (!playing) explain.textContent = text(explainKey(selected(scene)));
    }
    if (phaseLine) {
      phaseLine.hidden = !playing;
      if (playing) phaseLine.textContent = text(phaseKey(scene.dataset.phase || 'visible'));
      else phaseLine.textContent = '';
    }
  };

  const applyLang = () => {
    document.documentElement.lang = lang;
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      if (key) el.textContent = text(key);
    });
    document.querySelectorAll<HTMLElement>('[data-behind]').forEach(renderCopy);
    document.querySelectorAll<HTMLButtonElement>('[data-lang-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.langToggle === lang ? 'true' : 'false');
    });
    const frame = document.querySelector<HTMLIFrameElement>('[data-reference]');
    if (frame) {
      frame.src = lang === 'en' ? '/en/' : '/';
      frame.title = text('currentTitle');
    }
    document.querySelectorAll<HTMLAnchorElement>('[data-href-fr]').forEach((anchor) => {
      const href = lang === 'en' ? anchor.dataset.hrefEn : anchor.dataset.hrefFr;
      if (href) anchor.href = href;
    });
  };

  const stop = (scene: HTMLElement) => {
    const raf = Number(scene.dataset.raf || 0);
    if (raf) cancelAnimationFrame(raf);
    scene.dataset.raf = '';
  };

  const settle = (scene: HTMLElement) => {
    stop(scene);
    scene.dataset.playing = 'false';
    scene.dataset.phase = 'settle';
    scene.dataset.closed = 'true';
    renderCopy(scene);
  };

  const play = (scene: HTMLElement, reason: 'auto' | 'replay' = 'replay') => {
    stop(scene);
    if (reduced) {
      settle(scene);
      if (reason === 'auto') scene.dataset.autoplayed = 'true';
      return;
    }
    scene.dataset.closed = 'false';
    scene.dataset.playing = 'true';
    scene.dataset.phase = 'visible';
    if (reason === 'auto') scene.dataset.autoplayed = 'true';
    renderCopy(scene);
    const started = performance.now();
    const tick = (now: number) => {
      if (scene.dataset.playing !== 'true') return;
      const elapsed = now - started;
      let phase: (typeof phases)[number] = 'visible';
      marks.forEach((at, index) => {
        if (elapsed >= at) phase = phases[index];
      });
      if (elapsed >= 9000) {
        settle(scene);
        return;
      }
      if (scene.dataset.phase !== phase) {
        scene.dataset.phase = phase;
        renderCopy(scene);
      }
      scene.dataset.raf = String(requestAnimationFrame(tick));
    };
    scene.dataset.raf = String(requestAnimationFrame(tick));
  };

  const watchVisibility = (scene: HTMLElement) => {
    if (scene.dataset.autoplay !== 'true') return;
    if (!('IntersectionObserver' in window)) {
      play(scene, 'auto');
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        if (entry.isIntersecting && entry.intersectionRatio >= 0.42) {
          if (scene.dataset.autoplayed !== 'true' && scene.dataset.playing !== 'true') {
            play(scene, 'auto');
          }
          return;
        }
        if (scene.dataset.playing === 'true') settle(scene);
      },
      { threshold: [0, 0.25, 0.42, 0.6, 0.85] },
    );
    observer.observe(scene);
  };

  document.querySelectorAll<HTMLElement>('[data-behind]').forEach((scene) => {
    renderCopy(scene);
    watchVisibility(scene);

    scene.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || target.type !== 'radio') return;
      if (scene.dataset.playing === 'true') settle(scene);
      else renderCopy(scene);
    });

    scene.querySelector('[data-replay]')?.addEventListener('click', () => play(scene, 'replay'));
    scene.querySelector('[data-skip]')?.addEventListener('click', () => settle(scene));
  });

  document.querySelectorAll<HTMLElement>('[data-chrome] .site-header').forEach((header) => {
    if (header.dataset.menuBound === 'true') return;
    header.dataset.menuBound = 'true';
    const button = header.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = header.querySelector<HTMLElement>('.mobile-nav');
    if (!button || !nav) return;
    const closedLabel = button.dataset.closedLabel || 'Menu';
    const openLabel = button.dataset.openLabel || 'Close menu';
    const close = () => {
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', closedLabel);
      nav.hidden = true;
    };
    const open = () => {
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', openLabel);
      nav.hidden = false;
    };
    button.addEventListener('click', () => {
      if (button.getAttribute('aria-expanded') === 'true') {
        close();
        button.focus();
      } else {
        open();
      }
    });
    nav.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        close();
        button.focus();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-lang-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.dataset.langToggle === 'en' ? 'en' : 'fr';
      if (next === lang) return;
      lang = next;
      applyLang();
    });
  });
  }
</script>
