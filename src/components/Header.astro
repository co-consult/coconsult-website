---
import Logo from '@/components/Logo.astro';
import { ui } from '@/content/ui';
import { contactPath } from '@/data/inquiries';
import { alternatePath, pathFor, primaryNav, routes, serviceNav } from '@/data/routes';
import type { Locale, RouteKey } from '@/content/types';

interface Props {
  locale: Locale;
  routeKey: RouteKey | 'notFound';
  menuId?: string;
}
const { locale, routeKey, menuId = 'mobile-menu' } = Astro.props;
const t = ui[locale];
const home = pathFor(locale, 'home');
const other = alternatePath(locale, routeKey);
const selfPath = routeKey === 'notFound' ? home : pathFor(locale, routeKey);
const contactHref = contactPath(locale, 'project');
---
<a class="skip-link" href="#main">{t.skip}</a>
<header class="site-header">
  <div class="container header-bar">
    <a class="brand" href={home} aria-label="Coconsult">
      <Logo height={64} src="/assets/brand/coconsult-logo.png" />
    </a>
    <nav class="desktop-nav" aria-label={t.navLabel}>
      {primaryNav.filter((key) => key !== 'contact').map((key) => (
        <a href={pathFor(locale, key)} aria-current={routeKey === key ? 'page' : undefined}>{routes[key].label[locale]}</a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={t.langAria}>
        <a class="lang-opt" href={locale === 'fr' ? selfPath : other} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'true' : undefined}>FR</a>
        <a class="lang-opt" href={locale === 'en' ? selfPath : other} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
      </div>
      <a class="header-contact" href={contactHref} aria-current={routeKey === 'contact' ? 'page' : undefined}>
        <span>{t.headerCta}</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls={menuId}
        aria-label={t.menu}
        data-closed-label={t.menu}
        data-open-label={t.close}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav id={menuId} class="mobile-nav" aria-label={t.navLabel} hidden>
    {primaryNav.map((key) => (
      <a href={pathFor(locale, key)} aria-current={routeKey === key ? 'page' : undefined}>{routes[key].label[locale]}</a>
    ))}
    <p class="mobile-label">{t.servicesGroup}</p>
    {serviceNav.map((key) => (
      <a href={pathFor(locale, key)} aria-current={routeKey === key ? 'page' : undefined}>{routes[key].label[locale]}</a>
    ))}
    <div class="lang-switch lang-switch-mobile" role="group" aria-label={t.langAria}>
      <a class="lang-opt" href={locale === 'fr' ? selfPath : other} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'true' : undefined}>FR</a>
      <a class="lang-opt" href={locale === 'en' ? selfPath : other} lang="en" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
    </div>
  </nav>
</header>
