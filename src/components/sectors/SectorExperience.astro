---
import SectorMatrix from '@/components/visuals/SectorMatrix.astro';
import type { Locale, PageContent } from '@/content/types';
import { contactPath } from '@/data/inquiries';
import { pathFor } from '@/data/routes';
import { crumbsFor } from '@/lib/seo';
import { ui } from '@/content/ui';

interface Props { locale: Locale; page: PageContent }
const { locale, page } = Astro.props;
const t = ui[locale];
const crumbs = crumbsFor(locale, 'sectors', t.home);
const fr = locale === 'fr';
const note = fr
  ? 'Des contextes exigeants où l’ingénierie s’exerce surtout en développement logiciel, DevOps et QA — pour fiabiliser, livrer et faire tenir des systèmes métier.'
  : 'Demanding contexts where engineering is practised mainly in software development, DevOps and QA — to harden, deliver and keep business systems running.';
const entryTitle = fr ? 'La technique reste le point d’entrée.' : 'Technical expertise stays the entry point.';
const entryText = fr
  ? 'IA & Data, développement, QA, Cloud & DevOps, cybersécurité et intégration : ces expertises s’appliquent à vos parcours métier. Les secteurs ci-dessus montrent où elles ont déjà été mises à l’épreuve.'
  : 'AI & Data, software, QA, Cloud & DevOps, cybersecurity and integration: these expertises apply to your business journeys. The industries above show where they have already been put to work.';
---
<div class="experience sectors-page">
  <header class="page-hero sectors-hero">
    <div class="container">
      {crumbs.length > 0 && (
        <nav aria-label={t.breadcrumb}>
          <ol class="crumbs">
            {crumbs.map((crumb) => (
              <li>
                {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p class="lede">{page.intro}</p>
      <p class="sectors-note">{note}</p>
    </div>
  </header>

  <section class="section" aria-labelledby="sectors-grid-title">
    <div class="section-head sectors-grid-head">
      <p class="eyebrow">{fr ? 'Cartographie' : 'Map'}</p>
      <div class="section-copy">
        <h2 id="sectors-grid-title">{fr ? 'Huit environnements métier.' : 'Eight business environments.'}</h2>
      </div>
    </div>
    <SectorMatrix locale={locale} variant="page" />
  </section>

  <section class="section paper" data-sectors-entry>
    <div class="section-head">
      <p class="eyebrow">{fr ? 'Expertises' : 'Expertise'}</p>
      <div class="section-copy">
        <h2>{entryTitle}</h2>
        <p class="lede-soft">{entryText}</p>
      </div>
    </div>
    <p class="sector-more">
      <a class="btn ghost" href={pathFor(locale, 'services')}>{fr ? 'Voir les expertises' : 'See the expertise'}</a>
      <a class="btn primary" href={contactPath(locale, 'project')}>{fr ? 'Parler d’un contexte métier' : 'Discuss a business context'}</a>
    </p>
  </section>
</div>
