---
import { chrome, pathFor } from '../assistant/knowledge.mjs';

interface Props {
  locale: 'fr' | 'en';
  lift?: boolean;
}

const { locale, lift = false } = Astro.props;
const copy = chrome(locale);
const contact = pathFor(locale, 'contact');
---

<div class:list={['cc-assistant', { 'cc-assistant-lift': lift }]}>
  <button
    type="button"
    class="cc-assistant-launcher"
    data-assistant-open
    data-locale={locale}
    aria-expanded="false"
    aria-controls="cc-assistant-dialog"
    aria-haspopup="dialog"
    aria-label={copy.openLabel}
  >
    <span class="cc-assistant-mark" aria-hidden="true"></span>
    <span>{copy.launcher}</span>
  </button>
  <div
    id="cc-assistant-dialog"
    class="cc-assistant-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cc-assistant-title"
    hidden
  >
    <div class="cc-assistant-head">
      <div>
        <p id="cc-assistant-title">{copy.title}</p>
        <p class="cc-assistant-disclosure">{copy.disclosure}</p>
      </div>
      <button type="button" data-assistant-close aria-label={copy.closeLabel}>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="cc-assistant-body">
      <div class="cc-assistant-log" role="log" aria-live="polite" aria-relevant="additions"></div>
      <div class="cc-assistant-choices"></div>
    </div>
    <form data-assistant-form>
      <label class="cc-assistant-sr" for="cc-assistant-input">{copy.inputLabel}</label>
      <textarea id="cc-assistant-input" maxlength="400" rows="2"></textarea>
      <button type="submit">{copy.sendLabel}</button>
    </form>
    <p class="cc-assistant-always">
      <a href={contact}>{copy.contactLabel}</a>
    </p>
  </div>
</div>

<script>
  const launcher = document.querySelector('[data-assistant-open]');
  if (launcher instanceof HTMLButtonElement && launcher.dataset.assistantBound !== 'true') {
    launcher.dataset.assistantBound = 'true';
    let ready: Promise<typeof import('../assistant/widget.mjs')> | null = null;
    let busy = false;
    const load = () => {
      ready ??= import('../assistant/widget.mjs');
      return ready;
    };
    launcher.addEventListener('click', () => {
      if (busy) return;
      busy = true;
      load()
        .then((mod) => {
          mod.mountAssistant(launcher);
          mod.toggleAssistant();
        })
        .catch(() => {})
        .finally(() => {
          busy = false;
        });
    });
  }
</script>

<style is:global>
  .cc-assistant-launcher,
  .cc-assistant-panel {
    position: fixed;
    z-index: 30;
    font-family: var(--sans);
  }

  .cc-assistant-launcher {
    right: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgba(142, 243, 255, 0.55);
    border-radius: 999px;
    background: #07111c;
    color: #8ef3ff;
    cursor: pointer;
  }

  .cc-assistant-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-teal);
  }

  .cc-assistant-panel {
    right: 16px;
    bottom: 72px;
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 32px));
    max-height: min(70vh, 560px, calc(100dvh - var(--header) - 96px));
    padding: 14px;
    border: 1px solid rgba(142, 243, 255, 0.4);
    border-radius: 18px;
    background: #07111c;
    color: #e7eef2;
    box-shadow: none;
  }

  .cc-assistant-body {
    overflow: auto;
    min-height: 0;
    flex: 1 1 auto;
  }

  .cc-assistant-lift .cc-assistant-launcher { bottom: 88px; }
  .cc-assistant-lift .cc-assistant-panel { bottom: 144px; }

  .cc-assistant-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
  }

  .cc-assistant-head p { margin: 0; }

  #cc-assistant-title {
    font-family: var(--display);
    font-size: 1.4rem;
    color: #8ef3ff;
  }

  .cc-assistant-disclosure {
    margin-top: 6px;
    color: #c5d2e0;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .cc-assistant-head button,
  .cc-assistant-panel form button,
  .cc-assistant-choice {
    min-height: 44px;
    border: 1px solid rgba(142, 243, 255, 0.45);
    border-radius: 999px;
    background: transparent;
    color: #e7eef2;
    cursor: pointer;
  }

  .cc-assistant-head button {
    width: 44px;
    padding: 0;
    font-size: 1.4rem;
    line-height: 1;
  }

  .cc-assistant-log {
    min-height: 0;
    margin: 12px 0;
    padding-right: 4px;
    line-height: 1.5;
  }

  .cc-assistant-log p,
  .cc-assistant-log ul { margin: 0 0 10px; white-space: pre-wrap; }

  .cc-assistant-log a { color: #8ef3ff; }

  .cc-assistant-contact,
  .cc-assistant-handoff {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    font-weight: 600;
  }

  .cc-assistant-handoff {
    margin-right: 8px;
    padding: 0 12px;
    border: 1px solid rgba(142, 243, 255, 0.45);
    border-radius: 999px;
    background: transparent;
    color: #8ef3ff;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .cc-assistant-launcher:focus-visible,
  .cc-assistant-head button:focus-visible,
  .cc-assistant-choice:focus-visible,
  .cc-assistant-handoff:focus-visible,
  .cc-assistant-panel form button:focus-visible,
  .cc-assistant-panel a:focus-visible,
  .cc-assistant-panel textarea:focus-visible {
    outline: 2px solid #8ef3ff;
    outline-offset: 2px;
  }

  .cc-assistant-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }

  .cc-assistant-choice { padding: 0 12px; text-align: left; }

  .cc-assistant-panel form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: end;
  }

  .cc-assistant-panel textarea {
    width: 100%;
    min-height: 44px;
    resize: vertical;
    border: 1px solid rgba(142, 243, 255, 0.35);
    border-radius: 12px;
    padding: 8px 10px;
    background: #050d16;
    color: #e7eef2;
    font: inherit;
  }

  .cc-assistant-panel form button { padding: 0 14px; }

  .cc-assistant-always {
    margin: 10px 0 0;
    font-size: 0.85rem;
  }

  .cc-assistant-always a { color: #8ef3ff; }

  .cc-assistant-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .cc-assistant-panel {
      right: 12px;
      left: 12px;
      width: auto;
      bottom: 68px;
      max-height: min(78dvh, 640px);
    }

    .cc-assistant-launcher { right: 12px; }

    .cc-assistant-lift .cc-assistant-panel { bottom: 128px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-assistant-launcher,
    .cc-assistant-panel { transition: none; }
  }
</style>
