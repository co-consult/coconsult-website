---
import type { Locale } from '@/content/types';
import { contactPath } from '@/data/inquiries';
import { workItems } from '@/data/work';

interface Props {
  locale: Locale;
  images?: Partial<Record<'dashboard' | 'quality' | 'lab', string>>;
}
const { locale, images = {} } = Astro.props;
const item = workItems.find((entry) => entry.id === 'copharia');
const fr = locale === 'fr';
const items = fr
  ? [['dashboard', 'Tableau de bord'], ['quality', 'Qualité'], ['lab', 'Laboratoire']] as const
  : [['dashboard', 'Dashboard'], ['quality', 'Quality'], ['lab', 'Laboratory']] as const;
const cta = fr ? 'Demander une démonstration de COPHARIA' : 'Request a COPHARIA demonstration';
---
<div class="experience work-host copharia-host">
  <div class="feature">
    <div class="feature-copy">
      <span class="badge">{item?.status[locale]}</span>
      <h2>COPHARIA</h2>
      <p>{item?.summary[locale]}</p>
      <ul class="capabilities">
        {items.map(([key, label]) => {
          const src = images[key];
          return (
            <li>
              {src && <img src={src} alt={`${label} — COPHARIA`} />}
              <strong>{label}</strong>
            </li>
          );
        })}
      </ul>
      <a class="btn primary" href={contactPath(locale, 'demo', 'copharia')}>{cta}</a>
    </div>
  </div>
</div>
