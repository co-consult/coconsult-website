---
import type { Locale } from '@/content/types';
import { pathFor } from '@/data/routes';
import { sportsShots } from '@/data/sports-shots';
import { workItems, type WorkItem } from '@/data/work';

interface Props { locale: Locale; id: 'iaps' | 'cssforever' }
const { locale, id } = Astro.props;
const item = workItems.find((entry) => entry.id === id) as WorkItem;
const casesHref = pathFor(locale, 'cases');
const fr = locale === 'fr';
const eyebrow = fr
  ? (id === 'iaps' ? 'Réalisation client' : 'Plateforme construite')
  : (id === 'iaps' ? 'Client delivery' : 'Built platform');
const caseLink = fr ? 'Voir l’étude de cas' : 'View the case study';
const slot = fr
  ? 'Le logiciel livré n’est pas reproduit ici. Le résultat du projet est écrit à côté.'
  : 'The delivered software is not reproduced here. The project result is written beside this space.';
const shot = id === 'cssforever' ? sportsShots[0] : null;
---
<div class="experience work-host platform-teaser">
  <article class="case case-teaser">
    <div class:list={['case-art', shot && 'has-shots']}>
      {shot ? (
        <figure class="shot shot-main">
          <picture>
            <source type="image/avif" srcset={`${shot.base}.avif`} />
            <source type="image/webp" srcset={`${shot.base}.webp`} />
            <img src={`${shot.base}.webp`} alt={shot.alt[locale]} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
          </picture>
          <figcaption>{shot.caption[locale]}</figcaption>
        </figure>
      ) : (
        <div class="case-slot">
          <p>{slot}</p>
        </div>
      )}
    </div>
    <div class="case-copy">
      <p class="eyebrow">{eyebrow}</p>
      <p class="badge">{item.status[locale]}</p>
      <h3>{item.title[locale]}</h3>
      <p>{item.summary[locale]}</p>
      <a class="btn ghost small" href={casesHref}>{caseLink}</a>
    </div>
  </article>
</div>
