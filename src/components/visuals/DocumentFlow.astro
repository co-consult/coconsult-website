---
import type { Locale } from '@/content/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const fr = locale === 'fr';
const steps = fr
  ? [
      ['document', 'Document'],
      ['review', 'Vérification'],
      ['validation', 'Validation'],
      ['follow', 'Suivi'],
    ]
  : [
      ['document', 'Document'],
      ['review', 'Verification'],
      ['validation', 'Validation'],
      ['follow', 'Follow-up'],
    ];
const kicker = fr ? 'Illustration conceptuelle' : 'Conceptual illustration';
const caption = fr
  ? 'Le logiciel livré n’est pas reproduit ici.'
  : 'The delivered software is not reproduced here.';
---
<figure class="doc-flow">
  <p class="doc-flow-kicker">{kicker}</p>
  <ol>
    {steps.map(([icon, name]) => (
      <li>
        <span class="doc-mark" aria-hidden="true">
          {icon === 'document' && (
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path d="M7 3.5h7.2L19 8.2V20.5H7V3.5z" fill="none" stroke="currentColor" stroke-width="1.4" />
              <path d="M14 3.8V8.4h4.4" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
          )}
          {icon === 'review' && (
            <svg viewBox="0 0 24 24" width="22" height="22">
              <circle cx="11" cy="11" r="5.2" fill="none" stroke="currentColor" stroke-width="1.4" />
              <path d="M15.2 15.2 19 19" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          )}
          {icon === 'validation' && (
            <svg viewBox="0 0 24 24" width="22" height="22">
              <circle cx="12" cy="12" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
              <path d="M8.6 12.2 11 14.6 15.5 9.7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {icon === 'follow' && (
            <svg viewBox="0 0 24 24" width="22" height="22">
              <circle cx="6.5" cy="16" r="1.7" fill="currentColor" />
              <circle cx="12" cy="10.5" r="1.7" fill="currentColor" />
              <circle cx="17.5" cy="6.5" r="1.7" fill="currentColor" />
              <path d="M8 14.8 10.5 12M13.5 9.4 16 7.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          )}
        </span>
        <span class="doc-name">{name}</span>
      </li>
    ))}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>
