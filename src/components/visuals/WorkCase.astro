---
import DocScene from '@/components/visuals/DocScene.astro';
import SportScene from '@/components/visuals/SportScene.astro';
import type { Locale } from '@/content/types';
import { contactPath } from '@/data/inquiries';
import { workItems, type WorkItem } from '@/data/work';

interface Props { locale: Locale; id: 'iaps' | 'cssforever' }
const { locale, id } = Astro.props;
const item = workItems.find((entry) => entry.id === id) as WorkItem;
const story = item.story?.[locale];
const moreLabel = locale === 'fr' ? 'Découvrir le projet' : 'Discover the project';
const lessLabel = locale === 'fr' ? 'Replier' : 'Collapse';
const eyebrow = locale === 'fr'
  ? (id === 'iaps' ? 'Gestion documentaire · composition originale' : 'Opérations numériques · composition originale')
  : (id === 'iaps' ? 'Document management · original composition' : 'Digital operations · original composition');
---
<div class="experience work-host">
  <article class="case">
    <div class="case-art">
      {id === 'iaps' ? <DocScene locale={locale} /> : <SportScene locale={locale} />}
    </div>
    <div class="case-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h3>{item.title[locale]}</h3>
      {story && <p>{story.context}</p>}
      <div class="more" hidden>
        {story && <p>{story.stake}</p>}
        {story && <p>{story.intervention}</p>}
        {story && <p>{story.result}</p>}
      </div>
      <button class="btn ghost small" type="button" data-case aria-expanded="false" data-more={moreLabel} data-less={lessLabel}>{moreLabel}</button>
      <a class="btn ghost small" href={contactPath(locale, 'project')}>{item.cta[locale].label}</a>
    </div>
  </article>
</div>
