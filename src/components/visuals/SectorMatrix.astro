---
import type { Locale } from '@/content/types';
import { pathFor } from '@/data/routes';
import { orderedSectors } from '@/data/sectors';

interface Props {
  locale: Locale;
  /** home = compact linked tiles + CTA; page = static cards with detail */
  variant?: 'home' | 'page';
}
const { locale, variant = 'home' } = Astro.props;
const fr = locale === 'fr';
const items = orderedSectors();
const sectorsHref = pathFor(locale, 'sectors');
const isHome = variant === 'home';

const icons: Record<string, string> = {
  finance: 'M8 20V8h4l2 4 2-4h4v12M12 20h8',
  mobility: 'M5 16h14M7 16V9l5-4 5 4v7M9 16v3M15 16v3',
  retail: 'M6 8h12l-1 12H7L6 8zm2-3h8l1 3H7l1-3z',
  media: 'M4 7h16v10H4zM8 21h8M12 17v4',
  telecom: 'M12 20v-4M8 16l4-12 4 12M6 20h12',
  sport: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 0v16M4 12h16',
  digital: 'M4 6h16v10H4zM9 20h6M12 16v4',
  pharma: 'M9 4h6v4H9zM8 8h8l1 12H7L8 8z',
};
---
<div class:list={['sector-matrix', { 'sector-matrix-home': isHome, 'sector-matrix-page': !isHome }]} data-sector-matrix data-stagger>
  <div class="sector-grid" role="list">
    {items.map((item) => {
      const path = icons[item.id] || icons.industry;
      const inner = (
        <>
          <span class="sector-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={path}></path>
            </svg>
          </span>
          <span class="sector-mark">{item.mark[locale]}</span>
          <strong>{item.title[locale]}</strong>
          {!isHome && <p>{item.summary[locale]}</p>}
          {!isHome && (
            <ul class="sector-angles">
              {item.angles[locale].map((angle) => <li>{angle}</li>)}
            </ul>
          )}
          {item.maturity === 'emerging' && (
            <span class="sector-badge">{fr ? 'Domaine émergent' : 'Emerging domain'}</span>
          )}
        </>
      );

      return isHome ? (
        <a
          class:list={['sector-tile', { emerging: item.maturity === 'emerging' }]}
          href={`${sectorsHref}#${item.id}`}
          role="listitem"
          data-sector={item.id}
        >
          {inner}
        </a>
      ) : (
        <article
          class:list={['sector-tile', { emerging: item.maturity === 'emerging' }]}
          id={item.id}
          role="listitem"
          data-sector={item.id}
        >
          {inner}
        </article>
      );
    })}
  </div>
  {isHome && (
    <p class="sector-more">
      <a class="btn ghost" href={sectorsHref}>{fr ? 'Explorer les secteurs' : 'Explore the industries'}</a>
    </p>
  )}
</div>
