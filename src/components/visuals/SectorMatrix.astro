---
import type { Locale } from '@/content/types';
import { pathFor } from '@/data/routes';
import { orderedSectors } from '@/data/sectors';

interface Props {
  locale: Locale;
  /** home = compact linked tiles + CTA; page = static cards with detail */
  variant?: 'home' | 'page';
}
const { locale, variant = 'home' } = Astro.props;
const fr = locale === 'fr';
const items = orderedSectors();
const sectorsHref = pathFor(locale, 'sectors');
const isHome = variant === 'home';

const icons: Record<string, string> = {
  finance: 'M8 20V8h4l2 4 2-4h4v12M12 20h8',
  mobility: 'M5 16h14M7 16V9l5-4 5 4v7M9 16v3M15 16v3',
  retail: 'M6 8h12l-1 12H7L6 8zm2-3h8l1 3H7l1-3z',
  media: 'M4 7h16v10H4zM8 21h8M12 17v4',
  telecom: 'M12 20v-4M8 16l4-12 4 12M6 20h12',
  sport: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm0 0v16M4 12h16',
  digital: 'M4 6h16v10H4zM9 20h6M12 16v4',
  pharma: 'M9 4h6v4H9zM8 8h8l1 12H7L8 8z',
};
---
<div class:list={['sector-matrix', { 'sector-matrix-home': isHome, 'sector-matrix-page': !isHome }]} data-sector-matrix data-stagger>
  <div class="sector-grid" role="list">
    {items.map((item) => {
      const path = icons[item.id] || icons.digital;
      const scene = !isHome ? (
        <div class={`sector-scene sector-scene-${item.id}`} aria-hidden="true">
          {item.id === 'finance' && (
            <svg viewBox="0 0 160 88" fill="none">
              <rect x="18" y="28" width="28" height="44" rx="4" stroke="currentColor" stroke-width="1.6" opacity="0.55" />
              <rect x="54" y="18" width="28" height="54" rx="4" stroke="currentColor" stroke-width="1.6" opacity="0.7" />
              <rect class="scene-rise" x="90" y="36" width="28" height="36" rx="4" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-draw" d="M22 70h116" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <path class="scene-pulse" d="M24 58l18-14 16 8 22-20 18 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {item.id === 'mobility' && (
            <svg viewBox="0 0 160 88" fill="none">
              <path class="scene-draw" d="M12 62c28-18 48-18 68 0s40 18 68 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.45" />
              <rect x="38" y="30" width="84" height="28" rx="10" stroke="currentColor" stroke-width="1.7" />
              <circle class="scene-spin" cx="56" cy="62" r="8" stroke="currentColor" stroke-width="1.7" />
              <circle class="scene-spin" cx="104" cy="62" r="8" stroke="currentColor" stroke-width="1.7" />
              <path class="scene-draw" d="M52 40h28M88 40h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
            </svg>
          )}
          {item.id === 'retail' && (
            <svg viewBox="0 0 160 88" fill="none">
              <path class="scene-rise" d="M36 30h88l-8 42H44L36 30z" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-draw" d="M48 24h64l6 6H42l6-6z" stroke="currentColor" stroke-width="1.6" />
              <circle class="scene-pulse" cx="70" cy="52" r="5" fill="currentColor" opacity="0.35" />
              <circle class="scene-pulse" cx="92" cy="52" r="5" fill="currentColor" opacity="0.35" style="animation-delay:0.4s" />
              <path class="scene-draw" d="M64 70h32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
            </svg>
          )}
          {item.id === 'media' && (
            <svg viewBox="0 0 160 88" fill="none">
              <rect class="scene-rise" x="28" y="18" width="104" height="52" rx="8" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-pulse" d="M48 44l24-12v24L48 44z" fill="currentColor" opacity="0.28" stroke="currentColor" stroke-width="1.4" />
              <path class="scene-draw" d="M88 36h28M88 46h22M88 56h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <rect class="scene-pulse" x="58" y="74" width="44" height="4" rx="2" fill="currentColor" opacity="0.35" />
            </svg>
          )}
          {item.id === 'telecom' && (
            <svg viewBox="0 0 160 88" fill="none">
              <path class="scene-wave" d="M80 66c-16-10-24-22-24-34" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <path class="scene-wave" d="M80 66c16-10 24-22 24-34" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" style="animation-delay:0.25s" />
              <path class="scene-wave" d="M80 66c-28-16-40-34-40-50" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.45" style="animation-delay:0.5s" />
              <path class="scene-wave" d="M80 66c28-16 40-34 40-50" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.45" style="animation-delay:0.75s" />
              <circle class="scene-pulse" cx="80" cy="70" r="5" fill="currentColor" />
            </svg>
          )}
          {item.id === 'sport' && (
            <svg viewBox="0 0 160 88" fill="none">
              <circle class="scene-spin" cx="80" cy="44" r="26" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-draw" d="M80 18v52M54 44h52" stroke="currentColor" stroke-width="1.4" opacity="0.55" />
              <path class="scene-draw" d="M58 28c10 8 34 8 44 0M58 60c10-8 34-8 44 0" stroke="currentColor" stroke-width="1.4" />
            </svg>
          )}
          {item.id === 'digital' && (
            <svg viewBox="0 0 160 88" fill="none">
              <rect class="scene-rise" x="34" y="16" width="92" height="50" rx="8" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-draw" d="M48 32h20M48 42h36M48 52h28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <circle class="scene-pulse" cx="108" cy="34" r="6" fill="currentColor" opacity="0.3" />
              <rect class="scene-pulse" x="66" y="70" width="28" height="5" rx="2.5" fill="currentColor" opacity="0.4" />
            </svg>
          )}
          {item.id === 'pharma' && (
            <svg viewBox="0 0 160 88" fill="none">
              <rect class="scene-rise" x="64" y="14" width="32" height="18" rx="4" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-draw" d="M58 32h44l8 40H50L58 32z" stroke="currentColor" stroke-width="1.6" />
              <path class="scene-pulse" d="M80 42v22M69 53h22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <circle class="scene-rise" cx="118" cy="58" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.55" />
            </svg>
          )}
        </div>
      ) : null;

      const inner = (
        <>
          {isHome ? (
            <span class="sector-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={path}></path>
              </svg>
            </span>
          ) : scene}
          <span class="sector-mark">{item.mark[locale]}</span>
          <strong>{item.title[locale]}</strong>
          {!isHome && <p>{item.summary[locale]}</p>}
          {!isHome && (
            <ul class="sector-angles">
              {item.angles[locale].map((angle) => <li>{angle}</li>)}
            </ul>
          )}
          {item.maturity === 'emerging' && (
            <span class="sector-badge">{fr ? 'Domaine émergent' : 'Emerging domain'}</span>
          )}
        </>
      );

      return isHome ? (
        <a
          class:list={['sector-tile', { emerging: item.maturity === 'emerging' }]}
          href={`${sectorsHref}#${item.id}`}
          role="listitem"
          data-sector={item.id}
        >
          {inner}
        </a>
      ) : (
        <article
          class:list={['sector-tile', { emerging: item.maturity === 'emerging' }]}
          id={item.id}
          role="listitem"
          data-sector={item.id}
        >
          {inner}
        </article>
      );
    })}
  </div>
  {isHome && (
    <p class="sector-more">
      <a class="btn ghost" href={sectorsHref}>{fr ? 'Explorer les secteurs' : 'Explore the industries'}</a>
    </p>
  )}
</div>
