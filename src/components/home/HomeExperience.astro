---
import FinalCta from '@/components/FinalCta.astro';
import PeopleImg from '@/components/visuals/PeopleImg.astro';
import SectorMatrix from '@/components/visuals/SectorMatrix.astro';
import WorkCase from '@/components/visuals/WorkCase.astro';
import type { Locale } from '@/content/types';
import { company } from '@/data/company';
import { imageAlt } from '@/data/image-alts';
import { contactPath } from '@/data/inquiries';
import { pathFor } from '@/data/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const behindHero = import.meta.env.PUBLIC_BEHIND_HERO === 'true';
const BehindScene = behindHero ? (await import('@/components/design/BehindScene.astro')).default : null;
const fr = locale === 'fr';
const talk = fr ? 'Parlons de votre projet' : "Let's talk about your project";
const projectHref = contactPath(locale, 'project');
const ciiYears = ['2026', '2027', '2028', '2029', '2030'];
const copy = fr
  ? {
      signature: 'Coconsult · Ingénierie',
      h1a: "L'intelligence au cœur de vos systèmes.",
      h1b: "L'ingénierie pour les concrétiser.",
      lede: 'IA, développement logiciel, cloud et qualité : Coconsult imagine et construit les solutions numériques qui font avancer les entreprises.',
      explore: 'Explorer nos expertises',
      valueKicker: 'Valeur ajoutée',
      valueTitle: 'Ce qui change pour vos projets.',
      valueIntro: 'Une maison d’ingénierie qui conçoit, livre et cadre — avec un agrément innovation reconnu.',
      values: [
        ['system', 'Systèmes métier', 'Applications, API et process qui tiennent en production, pas seulement en démonstration.'],
        ['ai', 'IA utile', 'Des modèles placés dans un parcours existant. La décision reste humaine.'],
        ['team', 'Équipes cadrées', 'Régie, forfait, squad dédiée ou nearshore avec Coconsult Nearshore à Sfax.'],
        ['cii', 'Innovation & CII', 'Prestataire agréé 2026–2030 pour accompagner des travaux d’innovation logicielle.'],
      ],
      ciiKicker: 'Agrément CII',
      ciiTitle: 'Un avantage concret pour vos projets d’innovation.',
      ciiLead:
        'COCONSULT est titulaire de l’agrément Crédit d’impôt innovation n° ' +
        company.cii.number +
        ', délivré par la ' +
        company.cii.authority +
        ' pour 2026 à 2030.',
      ciiBenefits: [
        ['Prestataire déjà agréé', 'Vous travaillez avec une société dont la capacité d’innovation est reconnue par l’administration.'],
        ['Cadrage clair', 'On sépare le prototype d’innovation de la régie ou de la maintenance courante.'],
        ['Horizon 5 ans', 'L’agrément couvre 2026 à 2030 : un cadre stable pour vos roadmaps produit.'],
        ['Transparence', 'Nous ne promettons pas un crédit d’impôt automatique. L’éligibilité d’un projet reste à vérifier.'],
      ],
      ciiChartLabel: 'Couverture de l’agrément',
      ciiCta: 'Étudier un sujet d’innovation',
      ciiNote: 'L’agrément reconnaît une capacité. Il ne décide pas qu’une mission ouvre droit au crédit d’impôt.',
      sysTitle: "Écosystème : un système relié à l'IA, au logiciel, au cloud et à la qualité.",
      core: 'Système',
      lanes: [
        ['ai', 'IA & Data', "Parcours IA : les données entrent, le modèle s'applique au processus, la décision reste humaine."],
        ['software', 'Développement', "Parcours développement : l'interface, l'API et les services tiennent le même produit."],
        ['cloud', 'Cloud & DevOps', "Parcours cloud : une version se construit, se teste, se déploie, puis s'observe."],
        ['quality', 'Qualité & Sécurité', 'Parcours qualité et sécurité : les tests et les droits protègent ce qui est exposé.'],
      ],
      focusAll: 'Quatre orbites relient le même système. Sélectionnez-en une pour la suivre.',
      systemHint: 'Explorer une orbite',
      exKicker: 'Expertises',
      exTitle: 'Découvrez nos expertises en action.',
      exIntro: "Chaque schéma est une démonstration pédagogique. Il n'exécute aucun traitement réel.",
      aiService: 'Intelligence artificielle et data',
      aiCta: 'Cadrer un diagnostic IA',
      teamCta: 'Constituer mon équipe',
      workKicker: 'Réalisations',
      workTitle: 'Notre ingénierie en action.',
      modeKicker: 'Modes',
      modeTitle: 'Des modèles de collaboration adaptés à vos projets.',
      modes: [
        ['Régie', "Un ou plusieurs ingénieurs, le temps d'un palier."],
        ['Forfait', 'Un périmètre clair, estimé puis réceptionné.'],
        ['Équipe dédiée', 'Une squad suivie dans la durée, cadrée depuis la France.'],
        ['Nearshore', 'Avec Coconsult Nearshore, société tunisienne juridiquement indépendante, à Sfax.'],
      ],
      sectorKicker: 'Secteurs',
      sectorTitle: 'Notre ingénierie au service de vos métiers.',
      sectorIntro: 'Des environnements où nos consultants ont déjà accompagné des systèmes exigeants.',
      end: 'Décrivez le défi. On part de là.',
    }
  : {
      signature: 'Coconsult · Engineering',
      h1a: 'Intelligence at the core of your systems.',
      h1b: 'Engineering to make them real.',
      lede: 'AI, software, cloud and quality: Coconsult designs and builds the digital systems that move companies forward.',
      explore: 'Explore our expertise',
      valueKicker: 'Added value',
      valueTitle: 'What changes for your projects.',
      valueIntro: 'An engineering house that designs, ships and scopes — with a recognised innovation agreement.',
      values: [
        ['system', 'Business systems', 'Applications, APIs and processes that hold in production, not only in demos.'],
        ['ai', 'Useful AI', 'Models placed inside an existing journey. The decision stays with a person.'],
        ['team', 'Scoped teams', 'Staff augmentation, fixed scope, dedicated squad, or nearshore with Coconsult Nearshore in Sfax.'],
        ['cii', 'Innovation & CII', 'An approved provider for 2026–2030 to support software innovation work.'],
      ],
      ciiKicker: 'CII agreement',
      ciiTitle: 'A concrete advantage for your innovation projects.',
      ciiLead:
        'COCONSULT holds French innovation tax credit agreement no. ' +
        company.cii.number +
        ', issued by ' +
        company.cii.authority +
        ' for 2026 to 2030.',
      ciiBenefits: [
        ['Already approved provider', 'You work with a company whose innovation capacity is recognised by the authority.'],
        ['Clear scoping', 'We separate the innovation prototype from day-to-day staff work or maintenance.'],
        ['Five-year horizon', 'The agreement covers 2026 to 2030: a stable frame for product roadmaps.'],
        ['Transparency', 'We do not promise an automatic tax credit. Project eligibility still has to be checked.'],
      ],
      ciiChartLabel: 'Agreement coverage',
      ciiCta: 'Scope an innovation subject',
      ciiNote: 'The agreement recognises a capacity. It does not decide that an assignment opens a tax credit.',
      sysTitle: 'Ecosystem: one system linked to AI, software, cloud and quality.',
      core: 'System',
      lanes: [
        ['ai', 'AI & Data', 'AI path: data comes in, a model serves the process, a person keeps the decision.'],
        ['software', 'Software Engineering', 'Software engineering path: interface, API and services hold the same product.'],
        ['cloud', 'Cloud & DevOps', 'Cloud path: a release is built, tested, deployed, then watched.'],
        ['quality', 'Quality & Security', 'Quality and security path: tests and access rights protect what is exposed.'],
      ],
      focusAll: 'Four orbits feed the same system. Select one to follow it.',
      systemHint: 'Explore an orbit',
      exKicker: 'Expertise',
      exTitle: 'Discover our expertise in action.',
      exIntro: 'Each diagram is a teaching sketch. It runs no real processing.',
      aiService: 'Artificial intelligence and data',
      aiCta: 'Request an AI diagnostic',
      teamCta: 'Build your team',
      workKicker: 'Work',
      workTitle: 'Our engineering in action.',
      modeKicker: 'Engagement',
      modeTitle: 'Collaboration models suited to your projects.',
      modes: [
        ['Staff augmentation', 'One or more engineers, for a defined stretch.'],
        ['Fixed scope', 'A clear scope, estimated and then accepted.'],
        ['Dedicated team', 'A squad over time, scoped from France.'],
        ['Nearshore', 'With Coconsult Nearshore, a legally independent Tunisian company in Sfax.'],
      ],
      sectorKicker: 'Industries',
      sectorTitle: 'Our engineering in the service of your industries.',
      sectorIntro: 'Environments where our consultants have already supported demanding systems.',
      end: 'Describe the challenge. We start there.',
    };
const skills = fr
  ? [
      ['ai', 'IA & Data'],
      ['software', 'Développement'],
      ['cloud', 'Cloud & DevOps'],
      ['qa', 'QA & Testing'],
      ['cyber', 'Cybersécurité'],
      ['integration', 'Intégration métier'],
    ]
  : [
      ['ai', 'AI & Data'],
      ['software', 'Software'],
      ['cloud', 'Cloud & DevOps'],
      ['qa', 'QA & Testing'],
      ['cyber', 'Cybersecurity'],
      ['integration', 'Business integration'],
    ];
const demo = fr
  ? {
      aiH: 'Du document au résultat métier.',
      docs: [['invoice', 'Facture', 'Exemple : montant et échéance relevés.'], ['contract', 'Contrat', 'Exemple : date de fin et signataire isolés.'], ['mail', 'Message', 'Exemple : demande classée en suivi.']],
      extract: 'Extraction',
      model: 'Analyse',
      out: 'Résultat',
      aiIdle: "Choisissez une pièce. L'exemple qui s'affiche est écrit à l'avance.",
      aiNote: "Démonstration illustrative. Aucun modèle n'est appelé.",
      softH: "De l'écran jusqu'à la donnée.",
      layers: [
        ['ui', 'Interface', "L'écran appelle l'API. La règle métier n'y habite pas."],
        ['api', 'API', "L'API tient le contrat entre l'écran et les services."],
        ['svc', 'Services métier', 'Les règles de gestion sont ici.'],
        ['db', 'Base de données', "La donnée persiste. L'écran ne l'écrit pas directement."],
      ],
      softIdle: "Sélectionnez une couche pour voir ce qu'elle relie.",
      cloudH: "Le chemin d'une version.",
      steps: ['Code', 'Build', 'Tests', 'Déploiement', 'Monitoring'],
      run: 'Suivre une version',
      plain: "Démonstration illustrative. Aucun système réel n'est exécuté.",
      qaH: 'Une campagne, puis la correction.',
      checks: ['Parcours nominal', 'API commande', 'Non-régression', "Cas d'erreur"],
      qaRun: 'Lancer la campagne',
      qaFix: 'Valider la correction',
      qaIdle: "La séquence est fictive. Elle montre le rythme d'une campagne.",
      qaFail: "Un cas d'erreur reste ouvert. Le reste passe.",
      qaOk: 'Campagne illustrée close, après correction.',
      cyberH: 'Qui peut voir quoi.',
      roles: [['read', 'Lecture'], ['edit', 'Édition'], ['admin', 'Admin']],
      file: 'Dossier',
      api: 'API',
      secret: 'Secrets',
      access: 'Accès',
      view: 'Visible',
      write: 'Modifiable',
      none: 'Fermé',
      cyberNote: "Schéma de droits. Ce n'est pas un audit, ni une attaque.",
      intH: 'Un dossier qui traverse les outils.',
      hops: ['ERP', 'GED', 'API', 'Application'],
      hopText: [
        "Le dossier est dans l'ERP.",
        'Le dossier est passé dans la GED.',
        "L'API porte le dossier vers l'application.",
        "L'application métier reçoit le dossier.",
      ],
      next: 'Faire passer le dossier',
    }
  : {
      aiH: 'From a document to a business result.',
      docs: [['invoice', 'Invoice', 'Example: amount and due date picked out.'], ['contract', 'Contract', 'Example: end date and signatory isolated.'], ['mail', 'Message', 'Example: request filed as a follow-up.']],
      extract: 'Extraction',
      model: 'Analysis',
      out: 'Result',
      aiIdle: 'Pick a document. The example that appears was written in advance.',
      aiNote: 'Illustrative demo. No model is called.',
      softH: 'From the screen down to the data.',
      layers: [
        ['ui', 'Interface', 'The screen calls the API. The business rule does not live there.'],
        ['api', 'API', 'The API holds the contract between the screen and the services.'],
        ['svc', 'Business services', 'The business rules sit here.'],
        ['db', 'Database', 'The data persists. The screen does not write it directly.'],
      ],
      softIdle: 'Select a layer to see what it connects.',
      cloudH: 'The path of a release.',
      steps: ['Code', 'Build', 'Tests', 'Deployment', 'Monitoring'],
      run: 'Follow a release',
      plain: 'Illustrative demo. No real system is executed.',
      qaH: 'A campaign, then the fix.',
      checks: ['Happy path', 'Order API', 'Regression', 'Error case'],
      qaRun: 'Run the campaign',
      qaFix: 'Mark the fix',
      qaIdle: 'The sequence is fictional. It shows the rhythm of a campaign.',
      qaFail: 'One error case stays open. The rest pass.',
      qaOk: 'Illustrated campaign closed, after the fix.',
      cyberH: 'Who can see what.',
      roles: [['read', 'Read'], ['edit', 'Edit'], ['admin', 'Admin']],
      file: 'File',
      api: 'API',
      secret: 'Secrets',
      access: 'Access',
      view: 'Visible',
      write: 'Editable',
      none: 'Closed',
      cyberNote: 'A rights sketch. Not an audit, and not an attack.',
      intH: 'A case file crossing the tools.',
      hops: ['ERP', 'Document store', 'API', 'Application'],
      hopText: [
        'The file is in the ERP.',
        'The file has moved into the document store.',
        'The API carries the file toward the application.',
        'The business application receives the file.',
      ],
      next: 'Move the file',
    };
---
<div class="experience">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{copy.signature}</p>
      <h1>
        <span>{copy.h1a}</span>
        <span class="accent">{copy.h1b}</span>
      </h1>
      <p class="lede">{copy.lede}</p>
      <div class="cta-row">
        <a class="btn primary" href={projectHref}>{talk}</a>
        <a class="btn ghost" href="#expertises">{copy.explore}</a>
      </div>
    </div>
      {BehindScene ? (
        <BehindScene locale={locale} instance="home" autoplay />
      ) : (
    <div class="system is-awaiting" data-focus="all" id="systeme">
      <div class="system-invite" aria-hidden="true">
        <span class="invite-comet"></span>
        <span class="invite-ripple"></span>
      </div>
      <p class="sr-only" data-system-hint>{copy.systemHint}</p>
      <div class="orbit-stage">
        <p class="focus-caption focus-caption-top" aria-hidden="true" data-all={copy.focusAll}>
          <span class="focus-typed" data-focus-typed>{copy.focusAll}</span><span class="focus-caret" aria-hidden="true"></span>
        </p>
        <svg viewBox="0 0 640 640" role="img" aria-labelledby="sysTitle">
          <title id="sysTitle">{copy.sysTitle}</title>
          <defs>
            <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#8ef3ff" stop-opacity="0.45"></stop>
              <stop offset="70%" stop-color="#8ef3ff" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <circle cx="320" cy="318" r="168" fill="url(#coreGlow)"></circle>
          <g class="field" fill="#8ef3ff">
            <circle cx="120" cy="120" r="1.4"></circle><circle cx="200" cy="88" r="1.4"></circle>
            <circle cx="440" cy="96" r="1.4"></circle><circle cx="540" cy="150" r="1.4"></circle>
            <circle cx="88" cy="300" r="1.4"></circle><circle cx="560" cy="340" r="1.4"></circle>
            <circle cx="150" cy="470" r="1.4"></circle><circle cx="500" cy="500" r="1.4"></circle>
            <circle cx="300" cy="540" r="1.4"></circle><circle cx="380" cy="70" r="1.4"></circle>
          </g>
          <circle class="orbit" cx="320" cy="318" r="92"></circle>
          <circle class="orbit" cx="320" cy="318" r="168"></circle>
          <path class="lane" data-lane="ai" d="M320 264 C 300 190 340 150 320 112"></path>
          <path class="lane" data-lane="software" d="M272 338 C 210 300 186 270 158 248"></path>
          <path class="lane" data-lane="cloud" d="M368 286 C 430 240 470 210 508 178"></path>
          <path class="lane" data-lane="quality" d="M356 364 C 400 410 424 450 448 478"></path>
          <circle class="endpoint" data-lane="ai" cx="320" cy="112" r="5"></circle>
          <circle class="endpoint" data-lane="software" cx="158" cy="248" r="5"></circle>
          <circle class="endpoint" data-lane="cloud" cx="508" cy="178" r="5"></circle>
          <circle class="endpoint" data-lane="quality" cx="448" cy="478" r="5"></circle>
          <circle class="core-ring" cx="320" cy="318" r="54"></circle>
          <circle class="core-ring inner" cx="320" cy="318" r="28"></circle>
          <circle class="particle" data-lane="ai" r="3.2"><animateMotion dur="4.2s" repeatCount="indefinite" path="M320 264 C 300 190 340 150 320 112"></animateMotion></circle>
          <circle class="particle" data-lane="software" r="3.2"><animateMotion dur="4.8s" repeatCount="indefinite" path="M272 338 C 210 300 186 270 158 248"></animateMotion></circle>
          <circle class="particle" data-lane="cloud" r="3.2"><animateMotion dur="3.8s" repeatCount="indefinite" path="M368 286 C 430 240 470 210 508 178"></animateMotion></circle>
          <circle class="particle" data-lane="quality" r="3.2"><animateMotion dur="5s" repeatCount="indefinite" path="M356 364 C 400 410 424 450 448 478"></animateMotion></circle>
        </svg>
        <div class="core-label"><strong>{copy.core}</strong></div>
        <div class="nodes">
          {copy.lanes.map(([id, label, focus]) => (
            <button class={`node node-${id} is-pulse`} type="button" data-lane={id} data-focus-text={focus} aria-pressed="false">
              <span class={`node-ico node-ico-${id}`} aria-hidden="true"></span>
              <span>{label}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="mobile-nodes">
        <p class="focus-caption" aria-hidden="true" data-all={copy.focusAll}>
          <span class="focus-typed" data-focus-typed>{copy.focusAll}</span><span class="focus-caret" aria-hidden="true"></span>
        </p>
        <div class="mobile-core" aria-hidden="true"><strong>{copy.core}</strong></div>
        {copy.lanes.map(([id, label, focus]) => (
          <button class="node is-pulse" type="button" data-lane={id} data-focus-text={focus} aria-pressed="false">
            <span class={`node-ico node-ico-${id}`} aria-hidden="true"></span>
            <span>{label}</span>
          </button>
        ))}
      </div>
      <p class="sr-only" aria-live="polite" data-focus-live>{copy.focusAll}</p>
    </div>
      )}
  </section>

  <section class="section paper value-section" id="valeur" data-reveal>
    <div class="section-head">
      <p class="eyebrow">{copy.valueKicker}</p>
      <div class="section-copy">
        <h2>{copy.valueTitle}</h2>
        <p class="lede-soft">{copy.valueIntro}</p>
      </div>
    </div>
    <div class="value-body">
      <figure class="people-frame">
        <PeopleImg
          src="/assets/people/workshop-journey.jpg"
          alt={imageAlt('/assets/people/workshop-journey.jpg', locale)}
          width={1280}
          height={720}
        />
        <figcaption>
          <span class="people-kicker">{fr ? 'Maison d’ingénierie' : 'Engineering house'}</span>
          <strong>{fr ? 'Cadrage, architecture, delivery' : 'Scoping, architecture, delivery'}</strong>
        </figcaption>
      </figure>
      <ul class="value-grid">
        {copy.values.map(([icon, title, text], index) => (
          <li class="value-card" style={`--delay:${index * 80}ms`}>
            <span class={`value-icon value-icon-${icon}`} aria-hidden="true">
              {icon === 'system' && (
                <svg viewBox="0 0 40 40" width="40" height="40"><rect x="6" y="8" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="22" y="8" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="22" width="12" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 18v4M28 18v4M20 18v4" stroke="currentColor" stroke-width="1.6"/></svg>
              )}
              {icon === 'ai' && (
                <svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 6v4M20 30v4M6 20h4M30 20h4M10 10l3 3M27 27l3 3M10 30l3-3M27 13l3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              )}
              {icon === 'team' && (
                <svg viewBox="0 0 40 40" width="40" height="40"><circle cx="14" cy="14" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="26" cy="14" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 30c1.5-5 5-7 12-7s10.5 2 12 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              )}
              {icon === 'cii' && (
                <svg viewBox="0 0 40 40" width="40" height="40"><path d="M8 28V12h8l4 6 4-6h8v16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 28h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              )}
            </span>
            <strong>{title}</strong>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section paper cii-showcase" id="cii" data-reveal aria-labelledby="cii-showcase-title">
    <div class="section-head">
      <p class="eyebrow">{copy.ciiKicker}</p>
      <div class="section-copy">
        <h2 id="cii-showcase-title">{copy.ciiTitle}</h2>
        <p class="lede-soft">{copy.ciiLead}</p>
      </div>
    </div>
    <div class="cii-showcase-grid">
      <div class="cii-showcase-copy">
        <ul class="cii-benefits">
          {copy.ciiBenefits.map(([title, text]) => (
            <li>
              <strong>{title}</strong>
              <span>{text}</span>
            </li>
          ))}
        </ul>
        <p class="cii-note">{copy.ciiNote}</p>
        <div class="cta-row">
          <a class="btn primary" href={pathFor(locale, 'innovation')}>{copy.ciiCta}</a>
          <a class="btn ghost" href={projectHref}>{talk}</a>
        </div>
      </div>
      <aside class="cii-seal" aria-label={copy.ciiChartLabel} data-cii-chart>
        <div class="cii-seal-brand">
          <img src="/assets/brand/coconsult-logo.png" alt="" width="148" height="102" loading="lazy" decoding="async" />
        </div>
        <p class="cii-seal-kicker">{copy.ciiChartLabel}</p>
        <p class="cii-seal-number">n° {company.cii.number}</p>
        <ul class="cii-year-chips">
          {ciiYears.map((year) => (
            <li>{year}</li>
          ))}
        </ul>
        <p class="cii-seal-cap">{company.cii.authority}</p>
        <p class="cii-seal-mark">{locale === 'fr' ? 'Prestataire agréé' : 'Approved provider'}</p>
      </aside>
    </div>
  </section>

  <section class="section paper" id="expertises" data-reveal>
    <div class="section-head">
      <p class="eyebrow">{copy.exKicker}</p>
      <div class="section-copy">
        <h2>{copy.exTitle}</h2>
        <p class="lede-soft">{copy.exIntro}</p>
      </div>
    </div>
    <div class="expertise-body expertise-stack">
      <figure class="people-frame expertise-photo">
        <PeopleImg
          src="/assets/people/engineer-focus.jpg"
          alt={imageAlt('/assets/people/engineer-focus.jpg', locale)}
          width={1280}
          height={720}
        />
        <figcaption>
          <span class="people-kicker">{fr ? 'Expertise en action' : 'Expertise in action'}</span>
          <strong>{fr ? 'Du schéma au système livré' : 'From sketch to shipped system'}</strong>
        </figcaption>
      </figure>
      <div class="stage stage-interactive" data-expertise-stage>
      <p class="stage-cue">{fr ? 'Interactif — choisissez une expertise, puis explorez le schéma.' : 'Interactive — pick an expertise, then explore the diagram.'}</p>
