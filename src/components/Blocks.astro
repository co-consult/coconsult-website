---
import { ui } from '@/content/ui';
import type { Block, Locale } from '@/content/types';
import { getInquiry, mailto } from '@/data/inquiries';
import { pathFor } from '@/data/routes';
import { visibleWork } from '@/data/work';
import { company } from '@/data/company';

interface Props { locale: Locale; blocks: Block[]; }
const { locale, blocks } = Astro.props;
const t = ui[locale];
const tones = ['band', 'band-alt', 'band', 'band-alt'];
---
{blocks.map((block, index) => {
  const tone = block.type === 'cta' ? 'band-dark' : tones[index % tones.length];
  return (
    <section class:list={['section', tone]}>
      <div class="container">
        {block.type === 'cards' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class:list={['card-grid', { five: block.items.length > 4 }]}>
              {block.items.map((item) => (
                <article class="service-card">
                  {item.kicker && <p class="kicker-no">{item.kicker}</p>}
                  <h3>{item.hrefKey ? <a href={pathFor(locale, item.hrefKey)}>{item.title}</a> : item.title}</h3>
                  <p>{item.text}</p>
                  {item.inquiry && <p><a class="text-link" href={mailto(getInquiry(locale, item.inquiry))}>{getInquiry(locale, item.inquiry).label}</a></p>}
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'columns' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="column-grid">
              {block.items.map((item) => (
                <article class="info-card">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'steps' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="steps">
              {block.items.map((item, stepIndex) => (
                <article class="step">
                  <span class="step-no">{String(stepIndex + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'prose' && (
          <div class="prose section-intro">
            {block.title && <h2>{block.title}</h2>}
            {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}
        {block.type === 'list' && (
          <>
            <div class="section-intro"><h2>{block.title}</h2></div>
            <ul class="plain-list">
              {block.items.map((item) => <li>{item}</li>)}
            </ul>
          </>
        )}
        {block.type === 'faq' && (
          <div class="faq">
            <div class="section-intro"><h2>{block.title}</h2></div>
            {block.items.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        )}
        {block.type === 'note' && <p class="note">{block.text}</p>}
        {block.type === 'diagram' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              <p class="caption">{block.caption}</p>
            </div>
            <ol class="flow">
              {block.steps.map((step) => (
                <li><strong>{step.title}</strong><span>{step.text}</span></li>
              ))}
            </ol>
          </>
        )}
        {block.type === 'work' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="work-grid">
              {visibleWork(block.source === 'cases' ? 'case' : 'solution').map((item) => {
                const cta = item.cta[locale];
                return (
                  <article class="work-card">
                    <div class="concept" role="img" aria-label={`${t.conceptual}. ${t.conceptualNote}`}>
                      <span>{t.conceptual}</span>
                    </div>
                    <p class="badge">{item.status[locale]}</p>
                    <h3>{item.title[locale]}</h3>
                    <p class="meta-line">{t.sector} · {item.sector[locale]}</p>
                    <p>{item.summary[locale]}</p>
                    <p class="meta-line">{t.benefits}</p>
                    <ul>
                      {item.benefits[locale].map((benefit) => <li>{benefit}</li>)}
                    </ul>
                    <a class="btn ghost" href={mailto(cta)}>{cta.label}</a>
                  </article>
                );
              })}
            </div>
          </>
        )}
        {block.type === 'inquiries' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
              <p class="contact-mail"><a href={`mailto:${company.email}`}>{company.email}</a></p>
            </div>
            <div class="intent-grid">
              {block.ids.map((id) => {
                const inquiry = getInquiry(locale, id);
                return (
                  <article class="intent-card" id={id}>
                    <h3>{inquiry.label}</h3>
                    <p>{inquiry.subject}</p>
                    <a class="btn ghost" href={mailto(inquiry)}>{inquiry.label}</a>
                  </article>
                );
              })}
            </div>
          </>
        )}
        {block.type === 'cta' && (
          <div class="section-intro">
            <h2>{block.title}</h2>
            <p>{block.text}</p>
            <div class="cta-actions">
              <a class="btn primary" href={mailto(getInquiry(locale, block.primary))}>{getInquiry(locale, block.primary).label}</a>
              {block.secondary && <a class="btn secondary" href={mailto(getInquiry(locale, block.secondary))}>{block.secondary === 'team' ? (locale === 'fr' ? 'Constituer une équipe' : 'Build your team') : getInquiry(locale, block.secondary).label}</a>}
            </div>
          </div>
        )}
      </div>
    </section>
  );
})}
