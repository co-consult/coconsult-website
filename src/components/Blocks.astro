---
import CophariaFeature from '@/components/visuals/CophariaFeature.astro';
import PlatformTeaser from '@/components/visuals/PlatformTeaser.astro';
import WorkCase from '@/components/visuals/WorkCase.astro';
import { ui } from '@/content/ui';
import type { Block, Locale } from '@/content/types';
import { contactPath, getInquiry, plainMailto } from '@/data/inquiries';
import { pathFor } from '@/data/routes';
import { visibleWork, workItems } from '@/data/work';
import { company } from '@/data/company';

interface Props { locale: Locale; blocks: Block[]; }
const { locale, blocks } = Astro.props;
const t = ui[locale];
const tones = ['band', 'band-alt', 'band', 'band-alt'];
const laneFor = (key?: string) => {
  if (key === 'ai') return 'ai';
  if (key === 'software') return 'software';
  if (key === 'cloud') return 'cloud';
  if (key === 'qa' || key === 'cyber') return 'quality';
  return undefined;
};
---
{blocks.map((block, index) => {
  const tone = block.type === 'cta' ? 'band-dark' : tones[index % tones.length];
  return (
    <section class:list={['section', tone]} data-reveal style={`--reveal-delay:${Math.min(index, 4) * 60}ms`}>
      <div class="container">
        {block.type === 'cards' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class:list={['card-grid', { bento: block.layout === 'bento', five: block.layout !== 'bento' && block.items.length > 4 }]} data-stagger>
              {block.items.map((item) => (
                <article class="service-card" data-lane={laneFor(item.hrefKey)}>
                  {item.kicker && <p class="kicker-no">{item.kicker}</p>}
          <h3>{item.hrefKey ? <a href={pathFor(locale, item.hrefKey)}>{item.title}</a> : item.title}</h3>
          <p>{item.text}</p>
          {item.link && <p><a class="text-link" href={pathFor(locale, item.link.hrefKey)}>{item.link.label}</a></p>}
                  {item.inquiry && <p><a class="text-link" href={contactPath(locale, item.inquiry)}>{getInquiry(locale, item.inquiry).label}</a></p>}
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'challenge' && (
          <>
            <div class="section-intro">
              <h2 id="challenge-heading">{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="challenge">
              <fieldset class="challenge-choices" aria-labelledby="challenge-heading">
                {block.items.map((item, choiceIndex) => (
                  <label class="choice">
                    <input type="radio" name={`challenge-${locale}`} id={`ch-${locale}-${item.id}`} value={item.id} checked={choiceIndex === 0} />
                    <span>{item.label}</span>
                  </label>
                ))}
              </fieldset>
              {block.items.map((item) => (
                <article class="challenge-panel" data-panel={item.id}>
                  <h3><a href={pathFor(locale, item.expertiseKey)}>{item.expertise}</a></h3>
                  <p>{item.useCase}</p>
                  <p><strong>{t.modeWord}. </strong>{item.mode}</p>
                  <p><a class="btn primary" href={contactPath(locale, item.inquiry)}>{getInquiry(locale, item.inquiry).label}</a></p>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'columns' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class:list={['column-grid', { rail: block.layout === 'rail' }]} data-stagger>
              {block.items.map((item, itemIndex) => (
                <article class="info-card">
                  {block.layout === 'rail' && <span class="rail-no">{String(itemIndex + 1).padStart(2, '0')}</span>}
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'steps' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="steps" data-stagger>
              {block.items.map((item, stepIndex) => (
                <article class="step">
                  <span class="step-no">{String(stepIndex + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'prose' && (
          <div class:list={['prose-block', block.visual && 'has-visual', block.visual && `prose-visual-${block.visual}`, block.visual === 'note' && 'prose-note']}>
            <div class="prose section-intro">
              {block.title && <h2>{block.title}</h2>}
              {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {block.visual === 'note' && (
              <aside class="prose-note-mark" aria-hidden="true">
                <span>{locale === 'fr' ? 'Limite' : 'Boundary'}</span>
                <strong>{locale === 'fr' ? 'Livrable client ≠ produit Coconsult' : 'Client deliverable ≠ Coconsult product'}</strong>
              </aside>
            )}
            {block.visual === 'collab' && (
              <figure class="prose-photo-panel">
                <img src="/assets/people/team-standup.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
                <figcaption>
                  <span>{locale === 'fr' ? 'Collaboration' : 'Collaboration'}</span>
                  <strong>{locale === 'fr' ? 'Paris · Sfax · un même cadrage' : 'Paris · Sfax · one framing'}</strong>
                </figcaption>
              </figure>
            )}
            {block.visual === 'entities' && (
              <div class="entity-map prose-visual-panel" aria-hidden="true">
                <div class="entity-card entity-fr">
                  <span class="entity-pin"></span>
                  <strong>COCONSULT</strong>
                  <span>{locale === 'fr' ? 'France · Paris' : 'France · Paris'}</span>
                </div>
                <div class="entity-link">
                  <span class="entity-dot"></span>
                  <span class="entity-rail"></span>
                  <span class="entity-dot"></span>
                </div>
                <div class="entity-card entity-tn">
                  <span class="entity-pin"></span>
                  <strong>Coconsult Nearshore</strong>
                  <span>{locale === 'fr' ? 'Tunisie · Sfax' : 'Tunisia · Sfax'}</span>
                </div>
              </div>
            )}
            {block.visual === 'nearshore' && (
              <div class="nearshore-visual prose-visual-panel" aria-hidden="true">
                <svg viewBox="0 0 120 120" width="120" height="120">
                  <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.25" />
                  <circle cx="60" cy="60" r="34" fill="none" stroke="currentColor" stroke-width="1.6" opacity="0.45" />
                  <path d="M38 68c8-18 36-18 44 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <circle cx="48" cy="48" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="72" cy="48" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </div>
            )}
            {block.visual === 'offers' && (
              <div class="prose-visual-panel" aria-hidden="true">
                <div class="offer-mosaic">
                  {(locale === 'fr'
                    ? [
                        ['Forfait', 'Périmètre cadré'],
                        ['Intégration', 'Systèmes existants'],
                        ['Équipes', 'Squads dédiées'],
                        ['QA & paiements', 'Missions ciblées'],
                        ['Solutions métier', 'En construction'],
                      ]
                    : [
                        ['Fixed scope', 'When the perimeter is clear'],
                        ['Integration', 'Existing systems'],
                        ['Teams', 'Dedicated squads'],
                        ['QA & payments', 'Focused missions'],
                        ['Business solutions', 'Still being built'],
                      ]
                  ).map(([title, text]) => (
                    <div class="offer-chip">
                      <strong>{title}</strong>
                      <span>{text}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {block.visual === 'cii' && (
              <div class="prose-visual-panel cii-visual" aria-hidden="true">
                <div class="cii-visual-seal">
                  <div>
                    <strong>CII</strong>
                    <span>{company.cii.number}</span>
                    <span>2026 — 2030</span>
                  </div>
                </div>
              </div>
            )}
            {block.visual === 'facts' && (
              <div class="prose-visual-panel facts-orbit" aria-hidden="true">
                <svg viewBox="0 0 280 240" role="img">
                  <circle cx="140" cy="120" r="34" fill="#fff" stroke="currentColor" stroke-width="1.6" />
                  <text x="140" y="116" text-anchor="middle" fill="currentColor" font-size="13" font-family="IBM Plex Mono, monospace">2018</text>
                  <text x="140" y="134" text-anchor="middle" fill="#24384c" font-size="11" font-family="IBM Plex Mono, monospace">Paris</text>
                  <g class="fact-ring" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.3">
                    <circle cx="140" cy="120" r="72" stroke-dasharray="4 7" />
                    <circle cx="140" cy="120" r="98" stroke-dasharray="2 8" />
                  </g>
                  <g fill="currentColor">
                    <circle cx="140" cy="48" r="6"><animate attributeName="r" values="5;7;5" dur="2.8s" repeatCount="indefinite" /></circle>
                    <circle cx="212" cy="88" r="6"><animate attributeName="r" values="6;8;6" dur="3.2s" repeatCount="indefinite" /></circle>
                    <circle cx="212" cy="152" r="6"><animate attributeName="r" values="5;7;5" dur="2.6s" repeatCount="indefinite" /></circle>
                    <circle cx="140" cy="192" r="6"><animate attributeName="r" values="6;8;6" dur="3.4s" repeatCount="indefinite" /></circle>
                    <circle cx="68" cy="152" r="6"><animate attributeName="r" values="5;7;5" dur="3s" repeatCount="indefinite" /></circle>
                    <circle cx="68" cy="88" r="6"><animate attributeName="r" values="6;8;6" dur="2.9s" repeatCount="indefinite" /></circle>
                  </g>
                </svg>
              </div>
            )}
          </div>
        )}
        {block.type === 'list' && (
          <>
            <div class="section-intro"><h2>{block.title}</h2></div>
            <ul class="plain-list">
              {block.items.map((item) => <li>{item}</li>)}
            </ul>
          </>
        )}
        {block.type === 'faq' && (
          <div class="faq">
            <div class="section-intro"><h2>{block.title}</h2></div>
            {block.items.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        )}
        {block.type === 'note' && <p class="note">{block.text}</p>}
        {block.type === 'diagram' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              <p class="caption">{block.caption}</p>
            </div>
            <ol class="flow">
              {block.steps.map((step) => (
                <li><strong>{step.title}</strong><span>{step.text}</span></li>
              ))}
            </ol>
          </>
        )}
        {block.type === 'work' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            {block.source === 'platforms' ? (
              <div class="work-grid platforms-grid">
                {workItems
                  .filter((item) => item.visible && item.group === 'case')
                  .sort((a, b) => a.order - b.order)
                  .map((item) => {
                    if (item.id === 'iaps' || item.id === 'cssforever') {
                      return <PlatformTeaser locale={locale} id={item.id} />;
                    }
                    return null;
                  })}
              </div>
            ) : (
              <div class="work-grid" data-stagger>
                {visibleWork(block.source === 'cases' ? 'case' : 'solution').map((item) => {
                  if (item.id === 'iaps' || item.id === 'cssforever') return <WorkCase locale={locale} id={item.id} />;
                  if (item.id === 'copharia') return <CophariaFeature locale={locale} />;
                  const cta = item.cta[locale];
                  return (
                    <article class="work-card">
                      <p class="badge">{item.status[locale]}</p>
                      <h3>{item.title[locale]}</h3>
                      <p class="meta-line">{t.sector} · {item.sector[locale]}</p>
                      {item.story ? (
                        <dl class="story">
                          <div><dt>{t.storyContext}</dt><dd>{item.story[locale].context}</dd></div>
                          <div><dt>{t.storyStake}</dt><dd>{item.story[locale].stake}</dd></div>
                          <div><dt>{t.storyWork}</dt><dd>{item.story[locale].intervention}</dd></div>
                          <div><dt>{t.storyResult}</dt><dd>{item.story[locale].result}</dd></div>
                        </dl>
                      ) : (
                        <p>{item.summary[locale]}</p>
                      )}
                      <p class="meta-line">{t.benefits}</p>
                      <ul>
                        {item.benefits[locale].map((benefit) => <li>{benefit}</li>)}
                      </ul>
                      <a class="btn ghost" href={item.group === 'solution' ? contactPath(locale, 'demo', item.id) : contactPath(locale, 'project')}>{cta.label}</a>
                    </article>
                  );
                })}
              </div>
            )}
          </>
        )}
        {block.type === 'inquiries' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="contact-panel" data-contact-panel data-email={company.email} data-copied={t.copied} data-copy-failed={t.copyFailed} data-failed={t.formFailed}>
              <p class="contact-mail"><a href={plainMailto()}>{company.email}</a></p>
              <div class="cta-actions">
                <button class="btn secondary on-light" type="button" data-copy-email>{t.copyAddress}</button>
                <a class="btn primary" data-open-mail href={plainMailto()}>{t.openMail}</a>
              </div>
              <p data-copy-status aria-live="polite"></p>
              <label class="field">
                <span>{t.needLabel}</span>
                <select data-contact-type name="type">
                  {block.ids.map((id) => {
                    const inquiry = getInquiry(locale, id);
                    return <option value={id} data-subject={inquiry.subject}>{inquiry.label}</option>;
                  })}
                </select>
              </label>
              <p class="form-unavailable" data-form-unavailable>{t.formUnavailable}</p>
              <form class="contact-form" data-contact-form hidden action="/api/contact" method="post">
                <label class="field">{t.formName}<input name="name" autocomplete="name" required maxlength="120" /></label>
                <label class="field">{t.formEmail}<input name="email" type="email" autocomplete="email" required maxlength="160" /></label>
                <label class="field">{t.formCompany}<input name="company" autocomplete="organization" maxlength="160" /></label>
                <label class="field">{t.formMessage}<textarea name="message" required minlength="20" maxlength="4000" rows="6"></textarea></label>
                <input class="hp" name="website" tabindex="-1" autocomplete="off" />
                <input type="hidden" name="type" data-hidden-type value="project" />
                <input type="hidden" name="product" data-hidden-product value="" />
                <p><a href={pathFor(locale, 'privacy')}>{t.privacyNote}</a></p>
                <button class="btn primary" type="submit">{t.formSend}</button>
                <p data-form-status role="status"></p>
              </form>
            </div>
          </>
        )}
        {block.type === 'cta' && (
          <div class="cta-panel">
            <div class="section-intro cta-copy">
              <h2>{block.title}</h2>
              <p>{block.text}</p>
              <div class="cta-actions">
                <a class="btn primary" href={contactPath(locale, block.primary, block.product)}>{block.product === 'copharia' ? (locale === 'fr' ? 'Demander une démonstration de COPHARIA' : 'Request a COPHARIA demonstration') : getInquiry(locale, block.primary).label}</a>
                {block.secondary && <a class="btn secondary" href={contactPath(locale, block.secondary)}>{block.secondary === 'team' ? (locale === 'fr' ? 'Constituer une équipe' : 'Build your team') : getInquiry(locale, block.secondary).label}</a>}
              </div>
            </div>
            <figure class="cta-photo" aria-hidden="true">
              <img src="/assets/people/project-handoff.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
            </figure>
          </div>
        )}
      </div>
    </section>
  );
})}
