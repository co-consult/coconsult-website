---
import CophariaFeature from '@/components/visuals/CophariaFeature.astro';
import WorkCase from '@/components/visuals/WorkCase.astro';
import { ui } from '@/content/ui';
import type { Block, Locale } from '@/content/types';
import { contactPath, getInquiry, plainMailto } from '@/data/inquiries';
import { pathFor } from '@/data/routes';
import { visibleWork } from '@/data/work';
import { company } from '@/data/company';

interface Props { locale: Locale; blocks: Block[]; }
const { locale, blocks } = Astro.props;
const t = ui[locale];
const tones = ['band', 'band-alt', 'band', 'band-alt'];
---
{blocks.map((block, index) => {
  const tone = block.type === 'cta' ? 'band-dark' : tones[index % tones.length];
  return (
    <section class:list={['section', tone]}>
      <div class="container">
        {block.type === 'cards' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class:list={['card-grid', { bento: block.layout === 'bento', five: block.layout !== 'bento' && block.items.length > 4 }]}>
              {block.items.map((item) => (
                <article class="service-card">
                  {item.kicker && <p class="kicker-no">{item.kicker}</p>}
                  <h3>{item.hrefKey ? <a href={pathFor(locale, item.hrefKey)}>{item.title}</a> : item.title}</h3>
                  <p>{item.text}</p>
                  {item.inquiry && <p><a class="text-link" href={contactPath(locale, item.inquiry)}>{getInquiry(locale, item.inquiry).label}</a></p>}
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'challenge' && (
          <>
            <div class="section-intro">
              <h2 id="challenge-heading">{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="challenge">
              <fieldset class="challenge-choices" aria-labelledby="challenge-heading">
                {block.items.map((item, choiceIndex) => (
                  <label class="choice">
                    <input type="radio" name={`challenge-${locale}`} id={`ch-${locale}-${item.id}`} value={item.id} checked={choiceIndex === 0} />
                    <span>{item.label}</span>
                  </label>
                ))}
              </fieldset>
              {block.items.map((item) => (
                <article class="challenge-panel" data-panel={item.id}>
                  <h3><a href={pathFor(locale, item.expertiseKey)}>{item.expertise}</a></h3>
                  <p>{item.useCase}</p>
                  <p><strong>{t.modeWord}. </strong>{item.mode}</p>
                  <p><a class="btn primary" href={contactPath(locale, item.inquiry)}>{getInquiry(locale, item.inquiry).label}</a></p>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'columns' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class:list={['column-grid', { rail: block.layout === 'rail' }]}>
              {block.items.map((item, itemIndex) => (
                <article class="info-card">
                  {block.layout === 'rail' && <span class="rail-no">{String(itemIndex + 1).padStart(2, '0')}</span>}
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'steps' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="steps">
              {block.items.map((item, stepIndex) => (
                <article class="step">
                  <span class="step-no">{String(stepIndex + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
        {block.type === 'prose' && (
          <div class="prose section-intro">
            {block.title && <h2>{block.title}</h2>}
            {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}
        {block.type === 'list' && (
          <>
            <div class="section-intro"><h2>{block.title}</h2></div>
            <ul class="plain-list">
              {block.items.map((item) => <li>{item}</li>)}
            </ul>
          </>
        )}
        {block.type === 'faq' && (
          <div class="faq">
            <div class="section-intro"><h2>{block.title}</h2></div>
            {block.items.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        )}
        {block.type === 'note' && <p class="note">{block.text}</p>}
        {block.type === 'diagram' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              <p class="caption">{block.caption}</p>
            </div>
            <ol class="flow">
              {block.steps.map((step) => (
                <li><strong>{step.title}</strong><span>{step.text}</span></li>
              ))}
            </ol>
          </>
        )}
        {block.type === 'work' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="work-grid">
              {visibleWork(block.source === 'cases' ? 'case' : 'solution').map((item) => {
                if (item.id === 'iaps' || item.id === 'cssforever') return <WorkCase locale={locale} id={item.id} />;
                if (item.id === 'copharia') return <CophariaFeature locale={locale} />;
                const cta = item.cta[locale];
                return (
                  <article class="work-card">
                    <p class="badge">{item.status[locale]}</p>
                    <h3>{item.title[locale]}</h3>
                    <p class="meta-line">{t.sector} · {item.sector[locale]}</p>
                    {item.story ? (
                      <dl class="story">
                        <div><dt>{t.storyContext}</dt><dd>{item.story[locale].context}</dd></div>
                        <div><dt>{t.storyStake}</dt><dd>{item.story[locale].stake}</dd></div>
                        <div><dt>{t.storyWork}</dt><dd>{item.story[locale].intervention}</dd></div>
                        <div><dt>{t.storyResult}</dt><dd>{item.story[locale].result}</dd></div>
                      </dl>
                    ) : (
                      <p>{item.summary[locale]}</p>
                    )}
                    <p class="meta-line">{t.benefits}</p>
                    <ul>
                      {item.benefits[locale].map((benefit) => <li>{benefit}</li>)}
                    </ul>
                    <a class="btn ghost" href={item.group === 'solution' ? contactPath(locale, 'demo', item.id) : contactPath(locale, 'project')}>{cta.label}</a>
                  </article>
                );
              })}
            </div>
          </>
        )}
        {block.type === 'inquiries' && (
          <>
            <div class="section-intro">
              <h2>{block.title}</h2>
              {block.intro && <p>{block.intro}</p>}
            </div>
            <div class="contact-panel" data-contact-panel data-email={company.email} data-copied={t.copied} data-copy-failed={t.copyFailed} data-failed={t.formFailed}>
              <p class="contact-mail"><a href={plainMailto()}>{company.email}</a></p>
              <div class="cta-actions">
                <button class="btn secondary on-light" type="button" data-copy-email>{t.copyAddress}</button>
                <a class="btn primary" data-open-mail href={plainMailto()}>{t.openMail}</a>
              </div>
              <p data-copy-status aria-live="polite"></p>
              <label class="field">
                <span>{t.needLabel}</span>
                <select data-contact-type name="type">
                  {block.ids.map((id) => {
                    const inquiry = getInquiry(locale, id);
                    return <option value={id} data-subject={inquiry.subject}>{inquiry.label}</option>;
                  })}
                </select>
              </label>
              <p class="form-unavailable" data-form-unavailable>{t.formUnavailable}</p>
              <form class="contact-form" data-contact-form hidden action="/api/contact" method="post">
                <label class="field">{t.formName}<input name="name" autocomplete="name" required maxlength="120" /></label>
                <label class="field">{t.formEmail}<input name="email" type="email" autocomplete="email" required maxlength="160" /></label>
                <label class="field">{t.formCompany}<input name="company" autocomplete="organization" maxlength="160" /></label>
                <label class="field">{t.formMessage}<textarea name="message" required minlength="20" maxlength="4000" rows="6"></textarea></label>
                <input class="hp" name="website" tabindex="-1" autocomplete="off" />
                <input type="hidden" name="type" data-hidden-type value="project" />
                <input type="hidden" name="product" data-hidden-product value="" />
                <p><a href={pathFor(locale, 'privacy')}>{t.privacyNote}</a></p>
                <button class="btn primary" type="submit">{t.formSend}</button>
                <p data-form-status role="status"></p>
              </form>
            </div>
          </>
        )}
        {block.type === 'cta' && (
          <div class="section-intro">
            <h2>{block.title}</h2>
            <p>{block.text}</p>
            <div class="cta-actions">
              <a class="btn primary" href={contactPath(locale, block.primary)}>{getInquiry(locale, block.primary).label}</a>
              {block.secondary && <a class="btn secondary" href={contactPath(locale, block.secondary)}>{block.secondary === 'team' ? (locale === 'fr' ? 'Constituer une équipe' : 'Build your team') : getInquiry(locale, block.secondary).label}</a>}
            </div>
          </div>
        )}
      </div>
    </section>
  );
})}
